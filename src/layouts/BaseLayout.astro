---
/**
 * Base layout (tickets 102, 203): head, meta, landmarks, theme bootstrapping.
 */
import '../styles/themes/default.css';
import '../styles/global.css';
// Every page theme in the folder (christmas, and any added later, ticket 1303). Terminal is also loaded by ConsoleSecret.
import.meta.glob('../styles/themes/*.css', { eager: true });
import { themeColor } from '../styles/themes/meta';
import type { PageTheme } from '../styles/themes';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsoleSecret from '../components/ConsoleSecret.astro';
import CopyCode from '../components/CopyCode.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getSite } from '../lib/content';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  type?: 'website' | 'article';
  published?: Date | undefined;
  modified?: Date | undefined;
  noindex?: boolean;
  /** Path of the Markdown twin for agent view (ticket 901). */
  markdownHref?: string | undefined;
  jsonLd?: Record<string, unknown> | undefined;
  /** Page theme from front matter (ticket 207). */
  theme?: PageTheme;
}

const {
  title,
  description,
  image,
  imageAlt,
  type = 'website',
  published,
  modified,
  noindex = false,
  markdownHref,
  jsonLd,
  theme = 'default',
} = Astro.props;

const site = await getSite();
const goatcounter = site.analytics?.goatcounter;
const vendoredCounter = goatcounter ? (await import('node:fs')).existsSync('public/js/count.js') : false;
if (goatcounter && !vendoredCounter) {
  throw new Error(
    'site.yaml sets analytics.goatcounter but public/js/count.js is missing. Vendor it first (ticket 703).',
  );
}
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = Astro.url.pathname === '/' ? `${site.name} | ${site.tagline}` : `${title} | ${site.name}`;
const og = image ? await getImage({ src: image, width: 1200, format: 'jpg', quality: 80 }) : undefined;
const ogUrl = og ? new URL(og.src, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en-GB" data-page-theme={theme === 'default' ? undefined : theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="preload" href="/fonts/mona-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    {markdownHref && (
      <link rel="alternate" type="text/markdown" href={markdownHref} title="Markdown version for agents" />
    )}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@_SamMullins_" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {/* Ticket 905 prototype: cross-document View Transitions, off unless enabled in site.yaml. */}
    {site.features.viewTransitions && <link rel="stylesheet" href="/css/view-transitions.css" />}
    {/* Ticket 703: GoatCounter, self-hosted script, only when a site code is configured. Production only. */}
    {goatcounter && import.meta.env.PROD && (
      <script
        is:inline
        async
        src="/js/count.js"
        data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
      ></script>
    )}

    <script is:inline>
      // Theme + JS flag before first paint (no flash of the wrong theme). Hashed by Astro's CSP.
      (function () {
        const d = document.documentElement;
        d.classList.add('js');
        try {
          const t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') d.dataset.theme = t;
        } catch {
          // Storage blocked: fall back to the system theme.
        }
        // Logo intro (904) on the first page of a session, decided before paint so it can't flash.
        try {
          if (!sessionStorage.getItem('sm-signature') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            d.classList.add('sig-intro');
          }
        } catch {
          // Storage blocked: skip the intro.
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">
      Skip to content
    </a>
    <Header>
      <slot name="header-actions" slot="actions" />
    </Header>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer>
      <slot name="colophon" slot="colophon" />
    </Footer>
    <ConsoleSecret />
    <CopyCode />
  </body>
</html>

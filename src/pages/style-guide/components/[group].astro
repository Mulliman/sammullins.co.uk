---
/**
 * Style guide: one component group (Sam, 28 November 2026). Each block's examples are rendered by the real
 * block components at full width, exactly as on the site. A row of tabs switches between a block's
 * variations, one shown at a time; the YAML and the block's fields are tucked into closed disclosures.
 * Without JS the tabs stay hidden and every example is shown in turn, each under its own heading.
 */
import StyleGuideLayout from '../../../components/StyleGuideLayout.astro';
import Blocks from '../../../components/Blocks.astro';
import StyleGuideSampleBody from '../../../components/StyleGuideSampleBody.astro';
import { componentGroups, componentSections, type ComponentGroup } from '../../../lib/style-guide-sections';

export function getStaticPaths() {
  return componentGroups.map((group) => ({ params: { group: group.slug }, props: { group } }));
}

interface Props {
  group: ComponentGroup;
}
const { group } = Astro.props;
const all = await componentSections();
const sections = group.types.map((t) => all.get(t)!);
const subnav = componentGroups.map((g) => ({ href: `/style-guide/components/${g.slug}/`, label: g.title }));
---

<StyleGuideLayout title={`${group.title}: components`} description={group.summary} wide={true} subnav={subnav}>
  <div class="container sg-head">
    <h1>{group.title}</h1>
    <p class="sg-head__lead">{group.summary}</p>
    <nav aria-label="Blocks on this page" class="sg-jump">
      <ul>
        {sections.map((s) => (
          <li>
            <a href={`#${s.id}`}>{s.title}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  {sections.map((s) => (
    <section class="sg-block" aria-labelledby={s.id}>
      <div class="container sg-block__head">
        <h2 id={s.id}>{s.title}</h2>
        <p class="sg-block__summary">{s.summary}</p>
        <details class="sg-details">
          <summary>Fields</summary>
          <div class="sg-table">
            <table class="sg-fields">
              <thead>
                <tr>
                  <th scope="col">Field</th>
                  <th scope="col">Type</th>
                  <th scope="col">Required</th>
                  <th scope="col">Default</th>
                </tr>
              </thead>
              <tbody>
                {s.fields.map((f) => (
                  <tr>
                    <th scope="row">
                      <code>{f.key}</code>
                    </th>
                    <td>
                      <code>{f.type}</code>
                    </td>
                    <td>{f.optional || f.dflt ? 'No' : 'Yes'}</td>
                    <td>{f.dflt ? <code>{f.dflt}</code> : ''}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </div>

      <div class="sg-tabs" data-tabs>
        {s.examples.length > 1 && (
          <div class="container">
            <div class="sg-tabs__list" role="tablist" aria-label={`${s.title} variations`} hidden data-tablist>
              {s.examples.map((ex, i) => (
                <button
                  type="button"
                  role="tab"
                  class="sg-tabs__tab"
                  id={`tab-${ex.id}`}
                  aria-controls={`panel-${ex.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                >
                  {ex.title}
                </button>
              ))}
            </div>
          </div>
        )}
        {s.examples.map((ex) => (
          <div class="sg-example" id={`panel-${ex.id}`} data-panel data-tab={`tab-${ex.id}`}>
            <div class="container">
              <h3 class="sg-example__title">{ex.title}</h3>
            </div>
            <div class="sg-example__render">
              <Blocks blocks={[ex.block]} Content={StyleGuideSampleBody} />
            </div>
            <div class="container sg-example__code">
              <details class="sg-details">
                <summary>YAML</summary>
                <Blocks blocks={[{ type: 'code', lang: 'yaml', filename: `${ex.id}.yaml`, code: ex.yaml }]} nested />
              </details>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}
</StyleGuideLayout>

<script>
  // Tabs for a block's variations (Sam, 28 November 2026): one example shown at a time. Arrow keys,
  // Home and End move between tabs (the WAI-ARIA tabs pattern, activation follows focus).
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const list = root.querySelector<HTMLElement>('[data-tablist]');
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    if (!list || panels.length < 2) continue;
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    list.hidden = false;
    root.classList.add('is-tabbed');
    for (const p of panels) {
      p.setAttribute('role', 'tabpanel');
      p.setAttribute('aria-labelledby', p.dataset.tab ?? '');
      p.tabIndex = -1;
    }
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
        panels[j]!.hidden = i !== j;
      });
      if (focus) tabs[i]!.focus();
    };
    select(0);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const to =
          e.key === 'ArrowRight'
            ? i === last
              ? 0
              : i + 1
            : e.key === 'ArrowLeft'
              ? i === 0
                ? last
                : i - 1
              : e.key === 'Home'
                ? 0
                : e.key === 'End'
                  ? last
                  : -1;
        if (to < 0) return;
        e.preventDefault();
        select(to, true);
      });
    });
  }
</script>

<style>
  .sg-head {
    padding-block: var(--space-l) var(--space-m-l);
    text-align: center;
  }
  .sg-head h1 {
    margin: 0 0 var(--space-s);
  }
  .sg-head__lead {
    max-width: 36em;
    margin: 0 auto;
    font-size: var(--step-1);
    line-height: var(--leading-lead);
    color: var(--color-text-muted);
    text-wrap: balance;
  }
  .sg-jump ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
  }
  .sg-jump a {
    display: block;
    padding: var(--space-3xs) var(--space-s);
    border-radius: var(--radius-pill);
    background: var(--color-bg-muted);
    color: var(--color-text-strong);
    font-size: var(--step--1);
    text-decoration: none;
  }
  .sg-jump a:hover {
    background: var(--color-text-strong);
    color: var(--color-bg);
  }

  /* One block: a centred heading, then its examples one after another, full width. */
  .sg-block {
    padding-top: var(--space-xl);
    scroll-margin-top: var(--header-h);
  }
  .sg-block__head {
    padding-bottom: var(--space-m);
    text-align: center;
  }
  .sg-block__head h2 {
    margin: 0 0 var(--space-2xs);
    scroll-margin-top: calc(var(--header-h) + var(--space-s));
  }
  .sg-block__summary {
    max-width: 36em;
    margin: 0 auto;
    color: var(--color-text-muted);
  }

  /* Tabs: one row of pills per block, the selected one filled. */
  .sg-tabs__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
    padding-bottom: var(--space-s);
  }
  .sg-tabs__list[hidden] {
    display: none;
  }
  .sg-tabs__tab {
    padding: var(--space-3xs) var(--space-s);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-bg-muted);
    color: var(--color-text);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
  }
  .sg-tabs__tab:hover {
    color: var(--color-heading);
  }
  .sg-tabs__tab[aria-selected='true'] {
    background: var(--color-text-strong);
    color: var(--color-bg);
    font-weight: var(--weight-strong);
  }
  /* Without JS, each example has a heading; with tabs, the tab names it. */
  .sg-example__title {
    margin: var(--space-m) 0 var(--space-xs);
    font-size: var(--step-0);
    font-weight: var(--weight-strong);
    color: var(--color-text-muted);
  }
  .sg-tabs.is-tabbed .sg-example__title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .sg-example__render {
    min-width: 0;
  }
  .sg-example__code {
    padding-block: var(--space-xs) var(--space-m);
  }

  .sg-details {
    text-align: left;
  }
  .sg-block__head .sg-details {
    display: inline-block;
    max-width: 100%;
    margin-top: var(--space-s);
  }
  .sg-details > summary {
    display: inline-block;
    padding: var(--space-3xs) var(--space-s);
    border-radius: var(--radius-pill);
    background: var(--color-bg-muted);
    color: var(--color-text-strong);
    font-size: var(--step--1);
    cursor: pointer;
  }
  .sg-details[open] > summary {
    margin-bottom: var(--space-s);
  }
  .sg-table {
    max-width: 100%;
    overflow-x: auto;
  }
  .sg-fields {
    border-collapse: collapse;
    font-size: var(--step--1);
  }
  .sg-fields th,
  .sg-fields td {
    padding: var(--space-3xs) var(--space-xs);
    text-align: left;
    vertical-align: top;
  }
  .sg-fields tbody tr:nth-child(odd) {
    background: var(--color-bg-muted);
  }
  .sg-fields code {
    overflow-wrap: anywhere;
  }
</style>

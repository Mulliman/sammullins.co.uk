---
/**
 * Style guide: components (tickets 1304, 1401). The blocks are grouped, a page per group (Sam, 28 November
 * 2026: one page of every block was overwhelming and looked nothing like the site). This page lists the
 * groups; each group page shows its blocks as they look on the site, with the YAML and fields tucked away.
 *
 * The checks (every block grouped and exampled, every enum option shown) run in componentSections().
 */
import StyleGuideLayout from '../../../components/StyleGuideLayout.astro';
import { componentGroups, componentSections } from '../../../lib/style-guide-sections';

const sections = await componentSections();
const subnav = componentGroups.map((g) => ({ href: `/style-guide/components/${g.slug}/`, label: g.title }));
---

<StyleGuideLayout
  title="Components"
  description="The site's blocks in six groups, each shown as it looks on the site, with the YAML that produces it."
  wide={true}
  subnav={subnav}
>
  <div class="container sg-head">
    <h1>Components</h1>
    <p class="sg-head__lead">
      Every page is a list of blocks. Here they are in six groups. Each group's page shows its blocks as they look on
      the site, with the YAML to copy under each example.
    </p>
  </div>

  <div class="container">
    <ul class="sg-groups">
      {componentGroups.map((g) => (
        <li class="sg-group">
          <h2 class="sg-group__title">
            <a href={`/style-guide/components/${g.slug}/`}>{g.title}</a>
          </h2>
          <p class="sg-group__summary">{g.summary}</p>
          <p class="sg-group__blocks">{g.types.map((t) => sections.get(t)?.title ?? t).join(', ')}</p>
        </li>
      ))}
    </ul>
  </div>
</StyleGuideLayout>

<style>
  .sg-head {
    padding-block: var(--space-l) var(--space-m-l);
    text-align: center;
  }
  .sg-head h1 {
    margin: 0 0 var(--space-s);
  }
  .sg-head__lead {
    max-width: 36em;
    margin: 0 auto;
    font-size: var(--step-1);
    line-height: var(--leading-lead);
    color: var(--color-text-muted);
    text-wrap: balance;
  }
  .sg-groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-s-m);
    list-style: none;
    margin: 0 0 var(--space-xl);
    padding: 0;
  }
  @media (min-width: 640px) {
    .sg-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 960px) {
    .sg-groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .sg-group {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding: var(--space-m);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    box-shadow: var(--shadow-card-rest);
    transition: box-shadow var(--dur) var(--ease-out);
  }
  .sg-group:hover {
    box-shadow: var(--shadow-card);
  }
  .sg-group__title {
    margin: 0;
    font-size: var(--step-2);
  }
  .sg-group__title a {
    color: inherit;
    text-decoration: none;
  }
  /* The whole card is the link. */
  .sg-group__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .sg-group:focus-within:has(:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  .sg-group__title a:focus-visible {
    outline: none;
  }
  .sg-group__summary {
    margin: 0;
    color: var(--color-text-muted);
  }
  .sg-group__blocks {
    margin: var(--space-2xs) 0 0;
    font-size: var(--step--1);
    color: var(--color-text-strong);
  }
</style>

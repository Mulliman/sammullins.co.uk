---
/**
 * Site header (tickets 203, 206): a compact sticky bar. The logo on the left; the nav, the agent
 * view toggle (passed in by entry pages through the `actions` slot) and the theme toggle on the
 * right. At most 72px tall on desktop and 64px on a phone. The mobile menu is a <details> element,
 * so it works without JS.
 */
import logo from '../assets/brand/logo.svg?raw';
import { getSite } from '../lib/content';
import ThemeToggle from './ThemeToggle.astro';

const site = await getSite();
const path = Astro.url.pathname;
// Gradient ids are prefixed so the footer's copy of the logo doesn't reuse these gradients.
const logoSvg = logo.replace(/_Linear/g, 'hdr_Linear');
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="logo" aria-label={`${site.name}, home`} data-signature>
      <span class="logo__mark" aria-hidden="true" set:html={logoSvg} />
    </a>

    <div class="site-header__end">
      <nav aria-label="Main" class="nav nav--desktop">
        <ul>
          {site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="site-header__tools">
        <slot name="actions" />
        <ThemeToggle />
      </div>

      <details class="nav nav--mobile">
        <summary>
          <span class="nav__burger" aria-hidden="true"></span>
          <span>Menu</span>
        </summary>
        <nav aria-label="Main (mobile)">
          <ul>
            {site.nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Progressive enhancement: Escape closes the mobile menu and returns focus.
  const menu = document.querySelector<HTMLDetailsElement>('.nav--mobile');
  menu?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });

  // Signature (904): the head script adds .sig-intro before first paint on the first page view of a
  // session (so the logo never shows, hides, then animates). Mark the session and tidy up afterwards.
  const root = document.documentElement;
  if (root.classList.contains('sig-intro')) {
    try {
      sessionStorage.setItem('sm-signature', '1');
    } catch {
      // Storage blocked: the intro may replay on the next page, which is harmless.
    }
    window.setTimeout(() => root.classList.remove('sig-intro'), 1500);
  }
</script>

<style>
  /* A compact sticky bar (ticket 206). Its height is --header-h (global.css), which anchors and
     sticky columns use as their offset, so headings never land under it. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    /* The bottom border counts towards --header-h, so the bar is exactly that tall. */
    height: calc(var(--header-h) - 1px);
    position: relative;
  }
  .site-header__end,
  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }
  .logo {
    display: block;
    height: 3.25rem;
    aspect-ratio: 4471 / 2309;
    color: var(--color-heading);
  }
  .logo__mark :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  .nav ul {
    list-style: none;
    padding: 0;
    display: flex;
  }
  .nav a {
    display: block;
    padding: var(--space-2xs) var(--space-xs);
    color: var(--color-nav);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--step-0);
  }
  .nav a:hover {
    color: var(--color-heading);
  }
  .nav a[aria-current='page'] {
    color: var(--color-text-strong);
    font-weight: var(--weight-strong);
  }

  .nav--mobile {
    display: none;
  }
  .nav--mobile summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    padding: var(--space-2xs);
  }
  .nav--mobile summary::-webkit-details-marker {
    display: none;
  }
  .nav__burger,
  .nav__burger::before,
  .nav__burger::after {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    position: relative;
  }
  .nav__burger::before,
  .nav__burger::after {
    content: '';
    position: absolute;
  }
  .nav__burger::before {
    top: -0.375rem;
  }
  .nav__burger::after {
    top: 0.375rem;
  }
  .nav--mobile nav {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 20;
    background: var(--color-bg);
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
    min-width: 12rem;
  }
  .nav--mobile ul {
    flex-direction: column;
    gap: var(--space-s);
  }

  /* Signature (904). The logo SVG has two groups: the name (MULLINS, then SAM) and the icon's 7 blocks.
     Only opacity and position animate, every animation ends exactly at the resting logo (no
     forwards fill), so nothing snaps or flickers when it finishes. Skipped under reduced motion. */
  .logo__mark :global(path),
  .logo__mark :global(rect) {
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* First view of a session: the icon's blocks settle into place in turn, then the name fades in. */
    :global(.sig-intro) .logo :global(svg > g:nth-of-type(2) > *) {
      animation: sig-settle 520ms var(--ease) backwards;
    }
    :global(.sig-intro) .logo :global(svg > g:first-of-type > *) {
      animation: sig-fade 500ms ease-out 420ms backwards;
    }
    :global(.sig-intro) .logo :global(svg > g:nth-of-type(2) > :nth-child(2)) {
      animation-delay: 50ms;
    }
    :global(.sig-intro) .logo :global(svg > g:nth-of-type(2) > :nth-child(3)) {
      animation-delay: 100ms;
    }
    :global(.sig-intro) .logo :global(svg > g:nth-of-type(2) > :nth-child(4)) {
      animation-delay: 150ms;
    }
    :global(.sig-intro) .logo :global(svg > g:nth-of-type(2) > :nth-child(5)) {
      animation-delay: 200ms;
    }
    :global(.sig-intro) .logo :global(svg > g:nth-of-type(2) > :nth-child(6)) {
      animation-delay: 250ms;
    }
    :global(.sig-intro) .logo :global(svg > g:nth-of-type(2) > :nth-child(7)) {
      animation-delay: 300ms;
    }

    /* Hover and keyboard focus: a small ripple runs across the icon's blocks. */
    .logo:is(:hover, :focus-visible) :global(svg > g:nth-of-type(2) > *) {
      animation: sig-ripple 420ms ease-in-out;
    }
    .logo:is(:hover, :focus-visible) :global(svg > g:nth-of-type(2) > :nth-child(2)) {
      animation-delay: 35ms;
    }
    .logo:is(:hover, :focus-visible) :global(svg > g:nth-of-type(2) > :nth-child(3)) {
      animation-delay: 70ms;
    }
    .logo:is(:hover, :focus-visible) :global(svg > g:nth-of-type(2) > :nth-child(4)) {
      animation-delay: 105ms;
    }
    .logo:is(:hover, :focus-visible) :global(svg > g:nth-of-type(2) > :nth-child(5)) {
      animation-delay: 140ms;
    }
    .logo:is(:hover, :focus-visible) :global(svg > g:nth-of-type(2) > :nth-child(6)) {
      animation-delay: 175ms;
    }
    .logo:is(:hover, :focus-visible) :global(svg > g:nth-of-type(2) > :nth-child(7)) {
      animation-delay: 210ms;
    }
  }

  @keyframes sig-settle {
    from {
      opacity: 0;
      transform: translateY(-18%);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes sig-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes sig-ripple {
    0%,
    100% {
      transform: none;
    }
    45% {
      transform: translateY(-7%);
    }
  }

  @media (max-width: 59.99rem) {
    .nav--desktop {
      display: none;
    }
    .nav--mobile {
      display: block;
    }
  }
  @media (max-width: 30rem) {
    .logo {
      height: 2.75rem;
    }
  }
</style>

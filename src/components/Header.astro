---
/**
 * Site header (tickets 203, 206, 209). At the top of the page it is a 100px masthead (80px on a phone)
 * with the stacked logo centred and the nav and theme toggle on the right (agent view moved to the
 * footer in ticket 209). It is sticky with a negative top, so once you
 * scroll, only its bottom --header-h stays on screen: the stacked logo gives way to the horizontal one on
 * the left and the nav stays where it is. One copy of every control, so nothing is duplicated for
 * assistive tech. The mobile menu is a <details> element, so it works without JS; without JS the header
 * simply isn't sticky.
 */
import Logo from './Logo.astro';
import { getSite } from '../lib/content';
import ThemeToggle from './ThemeToggle.astro';

const site = await getSite();
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header" data-site-header>
  <div class="site-header__sentinel" aria-hidden="true"></div>
  <div class="container site-header__inner">
    <a href="/" class="site-logo site-logo--stacked" aria-label={`${site.name}, home`} data-signature>
      <Logo lockup="stacked" />
    </a>
    <a href="/" class="site-logo site-logo--horizontal" aria-label={`${site.name}, home`}>
      <Logo lockup="horizontal" />
    </a>

    <div class="site-header__end">
      <nav aria-label="Main" class="nav nav--desktop">
        <ul>
          {site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="site-header__tools">
        <ThemeToggle />
      </div>

      <details class="nav nav--mobile">
        <summary>
          <span class="nav__burger" aria-hidden="true"></span>
          <span>Menu</span>
        </summary>
        <nav aria-label="Main (mobile)">
          <ul>
            {site.nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Progressive enhancement: Escape closes the mobile menu and returns focus.
  const menu = document.querySelector<HTMLDetailsElement>('.nav--mobile');
  menu?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });

  // Masthead to bar (209): the sentinel is the part of the header that scrolls off before it sticks.
  // Once it has gone, the header is stuck and swaps to the horizontal logo.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const sentinel = header?.querySelector('.site-header__sentinel');
  if (header && sentinel && 'IntersectionObserver' in window) {
    // The -1px top margin: once stuck, the sentinel's bottom edge sits exactly on the viewport's top,
    // which would still count as intersecting.
    new IntersectionObserver(([entry]) => header.classList.toggle('is-stuck', !entry?.isIntersecting), {
      rootMargin: '-1px 0px 0px 0px',
    }).observe(sentinel);
  }

  // Signature (904): the head script adds .sig-intro before first paint on the first page view of a
  // session (so the logo never shows, hides, then animates). Mark the session and tidy up afterwards.
  const root = document.documentElement;
  if (root.classList.contains('sig-intro')) {
    try {
      sessionStorage.setItem('sm-signature', '1');
    } catch {
      // Storage blocked: the intro may replay on the next page, which is harmless.
    }
    window.setTimeout(() => root.classList.remove('sig-intro'), 1700);
  }
</script>

<style>
  /* The masthead (ticket 209). It is --masthead-h tall and sticks at top: --header-h minus that, so
     the stuck bar is exactly --header-h, which anchors and sticky columns use as their offset. */
  .site-header {
    position: relative;
    z-index: 30;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  :global(html.js) .site-header {
    position: sticky;
    top: calc(var(--header-h) - var(--masthead-h));
  }
  .site-header__sentinel {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--masthead-h) - var(--header-h));
    pointer-events: none;
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-s);
    /* The bottom border counts towards the height. */
    height: calc(var(--masthead-h) - 1px);
    position: relative;
    transition: transform var(--dur) var(--ease);
  }
  /* Stuck: centre everything in the part of the header that is still on screen. */
  .is-stuck .site-header__inner {
    transform: translateY(calc((var(--masthead-h) - var(--header-h)) / 2));
  }
  .site-header__end {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
  }
  .site-header__end,
  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }
  .site-logo {
    display: block;
    grid-row: 1;
    color: var(--color-heading);
    transition:
      opacity var(--dur) ease,
      transform var(--dur) var(--ease),
      visibility 0s;
  }
  .site-logo :global(svg) {
    display: block;
    height: 100%;
    width: auto;
  }
  /* Each link gets its lockup's aspect ratio (the SVG viewBoxes), so a squeezed grid column can't collapse it. */
  .site-logo--stacked {
    grid-column: 2;
    /* About 60px of artwork with 20px above and below; the old 80px image had padding built in. */
    height: calc(var(--masthead-h) - 2.5rem);
    aspect-ratio: 912 / 440;
  }
  .site-logo--horizontal {
    grid-column: 1;
    justify-self: start;
    height: 2rem;
    aspect-ratio: 1326 / 193;
  }
  /* Only one logo is visible (and focusable) at a time; visibility flips after the fade. */
  .site-logo--horizontal,
  .is-stuck .site-logo--stacked {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur) ease,
      transform var(--dur) var(--ease),
      visibility 0s linear var(--dur);
  }
  .site-logo--horizontal {
    transform: translateY(30%);
  }
  .is-stuck .site-logo--stacked {
    transform: scale(0.85);
  }
  .is-stuck .site-logo--horizontal {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity var(--dur) ease,
      transform var(--dur) var(--ease),
      visibility 0s;
  }
  .nav ul {
    list-style: none;
    padding: 0;
    display: flex;
  }
  .nav a {
    display: block;
    padding: var(--space-2xs) var(--space-xs);
    color: var(--color-nav);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-0);
  }
  .nav a:hover {
    color: var(--color-heading);
  }
  .nav a[aria-current='page'] {
    color: var(--color-text-strong);
    font-weight: var(--weight-strong);
  }

  .nav--mobile {
    display: none;
  }
  .nav--mobile summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    padding: var(--space-2xs);
  }
  .nav--mobile summary::-webkit-details-marker {
    display: none;
  }
  .nav__burger,
  .nav__burger::before,
  .nav__burger::after {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    position: relative;
  }
  .nav__burger::before,
  .nav__burger::after {
    content: '';
    position: absolute;
  }
  .nav__burger::before {
    top: -0.375rem;
  }
  .nav__burger::after {
    top: 0.375rem;
  }
  .nav--mobile nav {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 20;
    background: var(--color-bg);
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
    min-width: 12rem;
  }
  .nav--mobile ul {
    flex-direction: column;
    gap: var(--space-s);
  }

  @media (max-width: 59.99rem) {
    .nav--desktop {
      display: none;
    }
    .nav--mobile {
      display: block;
    }
  }
  /* Phones: the toggles and menu leave no room to centre the logo, so both logos sit on the left. */
  @media (max-width: 40rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
    }
    .site-logo--stacked {
      grid-column: 1;
      justify-self: start;
    }
    .site-header__end {
      grid-column: 2;
    }
  }
  @media (max-width: 30rem) {
    .site-header__inner {
      gap: var(--space-2xs);
    }
    .site-logo--stacked {
      height: calc(var(--masthead-h) - 2rem);
    }
    .site-logo--horizontal {
      height: 1.5rem;
    }
  }
</style>

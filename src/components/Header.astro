---
/**
 * Site header (ticket 203). The mobile menu is a <details> element, so it works without JS.
 */
import logo from '../assets/brand/logo.svg?raw';
import { getSite } from '../lib/content';
import ThemeToggle from './ThemeToggle.astro';

const site = await getSite();
const path = Astro.url.pathname;
// Signature (904): each shape gets pathLength=1 so stroke-dasharray: 1 is the whole outline.
// Gradient ids are prefixed so the footer's copy of the logo doesn't reuse these gradients.
const logoSvg = logo.replace(/<(path|rect) /g, '<$1 pathLength="1" ').replace(/_Linear/g, 'hdr_Linear');
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header">
  <div class="container site-header__inner">
    <div class="site-header__start">
      <ThemeToggle />
    </div>

    <a href="/" class="logo" aria-label={`${site.name}, home`} data-signature>
      <span class="logo__mark" aria-hidden="true" set:html={logoSvg} />
    </a>

    <nav aria-label="Main" class="nav nav--desktop">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <details class="nav nav--mobile">
      <summary>
        <span class="nav__burger" aria-hidden="true"></span>
        <span>Menu</span>
      </summary>
      <nav aria-label="Main (mobile)">
        <ul>
          {site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // Progressive enhancement: Escape closes the mobile menu and returns focus.
  const menu = document.querySelector<HTMLDetailsElement>('.nav--mobile');
  menu?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });

  // Signature (904): the first page view of a session draws the logo once. Skipped under reduced motion.
  const logoLink = document.querySelector<HTMLElement>('[data-signature]');
  let firstView: boolean;
  try {
    firstView = sessionStorage.getItem('sm-signature') === null;
    if (firstView) sessionStorage.setItem('sm-signature', '1');
  } catch {
    firstView = false;
  }
  if (logoLink && firstView && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    logoLink.classList.add('is-drawing');
    window.setTimeout(() => logoLink.classList.remove('is-drawing'), 2000);
  }
</script>

<style>
  /* As the original: a light bar, logo centred, nav on the right. The theme toggle takes the empty left slot. */
  .site-header {
    background: var(--color-bg);
    padding-block: 10px;
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-s);
    min-height: 80px;
    position: relative;
  }
  .site-header__start {
    justify-self: start;
  }
  .logo {
    display: block;
    height: 80px;
    aspect-ratio: 4471 / 2309;
    color: var(--color-heading);
  }
  .logo__mark :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  .nav--desktop,
  .nav--mobile {
    justify-self: end;
  }
  .nav ul {
    list-style: none;
    padding: 0;
    display: flex;
  }
  .nav a {
    display: block;
    padding: var(--space-2xs) 15px;
    color: #6b6b6b;
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 400;
    font-size: 0.9167rem;
  }
  .nav a:hover {
    color: var(--color-heading);
  }
  .nav a[aria-current='page'] {
    color: var(--color-text-strong);
    font-weight: 700;
  }
  :global(:root[data-theme='dark']) .nav a {
    color: #b5b5b5;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .nav a {
      color: #b5b5b5;
    }
  }

  .nav--mobile {
    display: none;
  }
  .nav--mobile summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--step--1);
    padding: var(--space-2xs);
  }
  .nav--mobile summary::-webkit-details-marker {
    display: none;
  }
  .nav__burger,
  .nav__burger::before,
  .nav__burger::after {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    position: relative;
  }
  .nav__burger::before,
  .nav__burger::after {
    content: '';
    position: absolute;
  }
  .nav__burger::before {
    top: -6px;
  }
  .nav__burger::after {
    top: 6px;
  }
  .nav--mobile nav {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 20;
    background: var(--color-bg);
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
    min-width: 12rem;
  }
  .nav--mobile ul {
    flex-direction: column;
    gap: var(--space-s);
  }

  /* Signature (904). Strokes are invisible at rest, so the static logo is unchanged and nothing shifts.
     Animation only runs when motion is allowed. Stroke width is in SVG units (viewBox is 4471 wide). */
  .logo__mark :global(path),
  .logo__mark :global(rect) {
    stroke: currentColor;
    stroke-width: 36;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    stroke-opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo.is-drawing :global(path),
    .logo.is-drawing :global(rect) {
      animation: sig-draw 0.9s var(--ease) both;
    }
    /* Stagger: each shape starts 20ms after the previous one (about 1.2s in total). */
    .logo.is-drawing :global(g > :nth-child(2)) {
      animation-delay: 20ms;
    }
    .logo.is-drawing :global(g > :nth-child(3)) {
      animation-delay: 40ms;
    }
    .logo.is-drawing :global(g > :nth-child(4)) {
      animation-delay: 60ms;
    }
    .logo.is-drawing :global(g > :nth-child(5)) {
      animation-delay: 80ms;
    }
    .logo.is-drawing :global(g > :nth-child(6)) {
      animation-delay: 100ms;
    }
    .logo.is-drawing :global(g > :nth-child(7)) {
      animation-delay: 120ms;
    }
    .logo.is-drawing :global(g > :nth-child(8)) {
      animation-delay: 140ms;
    }
    .logo.is-drawing :global(g > :nth-child(9)) {
      animation-delay: 160ms;
    }
    .logo.is-drawing :global(g > :nth-child(10)) {
      animation-delay: 180ms;
    }
    .logo.is-drawing :global(g > :nth-child(11)) {
      animation-delay: 200ms;
    }
    .logo.is-drawing :global(g > :nth-child(12)) {
      animation-delay: 220ms;
    }
    .logo.is-drawing :global(g > :nth-child(13)) {
      animation-delay: 240ms;
    }
    .logo.is-drawing :global(g > :nth-child(14)) {
      animation-delay: 260ms;
    }
    .logo.is-drawing :global(g > :nth-child(15)) {
      animation-delay: 280ms;
    }
    .logo.is-drawing :global(g > :nth-child(16)) {
      animation-delay: 300ms;
    }
    .logo.is-drawing :global(g > :nth-child(17)) {
      animation-delay: 320ms;
    }

    /* Hover and keyboard focus: a quick re-trace in the orange accent, then it fades back. */
    .logo:is(:hover, :focus-visible) :global(path),
    .logo:is(:hover, :focus-visible) :global(rect) {
      stroke: var(--brand-orange);
      animation: sig-trace 0.8s var(--ease) both;
    }
  }

  @keyframes sig-draw {
    0% {
      stroke-dashoffset: 1;
      stroke-opacity: 1;
      fill-opacity: 0;
    }
    65% {
      stroke-dashoffset: 0;
      stroke-opacity: 1;
      fill-opacity: 0;
    }
    100% {
      stroke-dashoffset: 0;
      stroke-opacity: 0;
      fill-opacity: 1;
    }
  }
  @keyframes sig-trace {
    from {
      stroke-dashoffset: 1;
      stroke-opacity: 0.6;
    }
    to {
      stroke-dashoffset: 0;
      stroke-opacity: 0;
    }
  }

  @media (max-width: 59.99rem) {
    .nav--desktop {
      display: none;
    }
    .nav--mobile {
      display: block;
    }
  }
  @media (max-width: 30rem) {
    .logo {
      height: 60px;
    }
  }
</style>

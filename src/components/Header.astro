---
/**
 * Site header (tickets 203, 206, 209). At the top of the page it is a 100px masthead (80px on a phone)
 * with the stacked logo centred and the nav and theme toggle on the right (agent view moved to the
 * footer in ticket 209). It is sticky with a negative top, so once you
 * scroll, only its bottom --header-h stays on screen: the stacked logo gives way to the horizontal one on
 * the left and the nav stays where it is. One copy of every control, so nothing is duplicated for
 * assistive tech. The mobile menu is a <details> element, so it works without JS; without JS the header
 * simply isn't sticky.
 *
 * The header is only the masthead shell (ticket 211): logo, sticky behaviour and an end area for
 * controls. The caller decides what goes in the end area, so a page without the site nav (the PM desk,
 * a microsite) gets the same masthead with nothing, or its own nav, on the right:
 *   default slot   the nav (SiteNav, or a microsite's own)
 *   slot "menu"    a mobile menu, placed after the tools
 *   themeToggle    the theme toggle between them (default true)
 *   sticky         masthead-to-bar on scroll (default: features.stickyHeader in site.yaml). When false
 *                  the masthead simply scrolls away with the page.
 *
 * While stuck, a back-to-top arrow slides in at the far right (ticket 211). It is a plain link to the
 * top of the page, so it works without JS; with JS a mouse click scrolls there smoothly.
 */
import Logo from './Logo.astro';
import { getSite } from '../lib/content';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  themeToggle?: boolean;
  sticky?: boolean;
}

const site = await getSite();
const { themeToggle = true, sticky = site.features.stickyHeader } = Astro.props;
---

<header class:list={['site-header', { 'site-header--sticky': sticky }]} data-site-header>
  {sticky && <div class="site-header__sentinel" aria-hidden="true" />}
  <div class="container site-header__inner">
    <a href="/" class="site-logo site-logo--stacked" aria-label={`${site.name}, home`} data-signature>
      <Logo lockup="stacked" />
    </a>
    <a href="/" class="site-logo site-logo--horizontal" aria-label={`${site.name}, home`}>
      <Logo lockup="horizontal" />
    </a>

    <div class="site-header__end">
      <slot />
      {themeToggle && (
        <div class="site-header__tools">
          <ThemeToggle />
        </div>
      )}
      <slot name="menu" />
      {sticky && (
        <a href="#top" class="site-header__top" aria-label="Back to top" data-back-to-top>
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 19V5M5 12l7-7 7 7" />
          </svg>
        </a>
      )}
    </div>
  </div>
</header>

<script>
  // Masthead to bar (209): the sentinel is the part of the header that scrolls off before it sticks.
  // Once it has gone, the header is stuck and swaps to the horizontal logo.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const sentinel = header?.querySelector('.site-header__sentinel');
  if (header && sentinel && 'IntersectionObserver' in window) {
    // The -1px top margin: once stuck, the sentinel's bottom edge sits exactly on the viewport's top,
    // which would still count as intersecting.
    new IntersectionObserver(([entry]) => header.classList.toggle('is-stuck', !entry?.isIntersecting), {
      rootMargin: '-1px 0px 0px 0px',
    }).observe(sentinel);
  }

  // Back to top (211): the link jumps to #top without JS, or for a keyboard user, so focus starts
  // from the top of the page. A mouse click scrolls there smoothly instead, unless motion is reduced.
  header?.querySelector('[data-back-to-top]')?.addEventListener('click', (e) => {
    const keyboard = (e as MouseEvent).detail === 0;
    if (keyboard || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Signature (904): the head script adds .sig-intro before first paint on the first page view of a
  // session (so the logo never shows, hides, then animates). Mark the session and tidy up afterwards.
  const root = document.documentElement;
  if (root.classList.contains('sig-intro')) {
    try {
      sessionStorage.setItem('sm-signature', '1');
    } catch {
      // Storage blocked: the intro may replay on the next page, which is harmless.
    }
    window.setTimeout(() => root.classList.remove('sig-intro'), 1700);
  }
</script>

<style>
  /* The masthead (ticket 209). It is --masthead-h tall and sticks at top: --header-h minus that, so
     the stuck bar is exactly --header-h, which anchors and sticky columns use as their offset. */
  .site-header {
    position: relative;
    z-index: 30;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  :global(html.js) .site-header--sticky {
    position: sticky;
    top: calc(var(--header-h) - var(--masthead-h));
    transition:
      background-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  /* Stuck (ticket 210): the bar goes slightly translucent and frosts what scrolls under it. */
  @supports (backdrop-filter: blur(1px)) {
    :global(html.js) .site-header.is-stuck {
      background: color-mix(in srgb, var(--color-bg) 82%, transparent);
      backdrop-filter: saturate(1.4) blur(14px);
    }
  }
  .site-header__sentinel {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--masthead-h) - var(--header-h));
    pointer-events: none;
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-s);
    /* The bottom border counts towards the height. */
    height: calc(var(--masthead-h) - 1px);
    position: relative;
    transition: transform var(--dur) var(--ease);
  }
  /* Stuck: centre everything in the part of the header that is still on screen. */
  .is-stuck .site-header__inner {
    transform: translateY(calc((var(--masthead-h) - var(--header-h)) / 2));
  }
  .site-header__end {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
  }
  /* Back to top: no width (and hidden from focus and assistive tech) until the header is stuck, then it
     grows in at the far right and the nav eases left to make room. */
  .site-header__top {
    display: grid;
    place-items: center;
    width: 0;
    height: 2.75rem;
    overflow: hidden;
    margin-left: calc(var(--space-2xs) * -1);
    color: var(--color-nav);
    opacity: 0;
    visibility: hidden;
    transition:
      width var(--dur) var(--ease),
      margin var(--dur) var(--ease),
      opacity var(--dur) ease,
      visibility 0s linear var(--dur);
  }
  .site-header__top:hover {
    color: var(--color-heading);
  }
  .is-stuck .site-header__top {
    width: 2.75rem;
    margin-left: 0;
    opacity: 1;
    visibility: visible;
    transition:
      width var(--dur) var(--ease),
      margin var(--dur) var(--ease),
      opacity var(--dur) ease,
      visibility 0s;
  }
  .site-header__end,
  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }
  .site-logo {
    display: block;
    grid-row: 1;
    color: var(--color-heading);
    transition:
      opacity var(--dur) ease,
      transform var(--dur) var(--ease),
      visibility 0s;
  }
  .site-logo :global(svg) {
    display: block;
    height: 100%;
    width: auto;
  }
  /* Each link gets its lockup's aspect ratio (the SVG viewBoxes), so a squeezed grid column can't collapse it. */
  .site-logo--stacked {
    grid-column: 2;
    /* About 60px of artwork with 20px above and below; the old 80px image had padding built in. */
    height: calc(var(--masthead-h) - 2.5rem);
    aspect-ratio: 912 / 440;
  }
  .site-logo--horizontal {
    grid-column: 1;
    justify-self: start;
    height: 2rem;
    aspect-ratio: 1326 / 193;
  }
  /* Only one logo is visible (and focusable) at a time; visibility flips after the fade. */
  .site-logo--horizontal,
  .is-stuck .site-logo--stacked {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur) ease,
      transform var(--dur) var(--ease),
      visibility 0s linear var(--dur);
  }
  .site-logo--horizontal {
    transform: translateY(30%);
  }
  .is-stuck .site-logo--stacked {
    transform: scale(0.85);
  }
  .is-stuck .site-logo--horizontal {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity var(--dur) ease,
      transform var(--dur) var(--ease),
      visibility 0s;
  }
  /* Phones (509-symmetry): the logo stays centred, with the theme toggle on the left and the menu
     (an icon; "Menu" is for screen readers) on the right. Both logos sit in the middle column. The
     back-to-top arrow is left out: there is no room for it beside a centred logo. */
  @media (max-width: 40rem) {
    .site-header__end {
      display: contents;
    }
    .site-header__tools {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
    }
    .site-header__end > :global(.nav--mobile) {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
    }
    .site-logo--stacked,
    .site-logo--horizontal {
      grid-column: 2;
      justify-self: center;
    }
    .site-header__top {
      display: none;
    }
  }
  @media (max-width: 30rem) {
    .site-header__inner {
      gap: var(--space-2xs);
    }
    .site-logo--stacked {
      height: calc(var(--masthead-h) - 2rem);
    }
    .site-logo--horizontal {
      height: 1.5rem;
    }
  }
</style>

---
/**
 * Article header (ticket 313): title, description, then a meta row below the title
 * (date, reading time and series part). Nothing sits above the title.
 */
interface Props {
  title: string;
  description: string;
  date: Date;
  minutes: number;
  part?: { part: number; total: number } | undefined;
  /** Archived articles get the archive note here, aligned with the article. */
  archived?: boolean;
}
const { title, description, date, minutes, part, archived = false } = Astro.props;
const fmt = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<header class="article-head">
  <div class="container">
    <h1 class="article-head__title">{title}</h1>
    <p class="article-head__lead">{description}</p>
    <ul class="article-head__meta">
      <li>
        <time datetime={date.toISOString().slice(0, 10)}>{fmt}</time>
      </li>
      <li>{minutes} min read</li>
      {part && (
        <li>
          Part {part.part} of {part.total}
        </li>
      )}
    </ul>
    {archived && (
      <p class="article-head__archived" role="note">
        <strong>From the archive.</strong> This is from an earlier chapter of my work and may be out of date. See the{' '}
        <a href="/archive/">archive</a> for more like it, or the <a href="/">home page</a> for what I'm doing now.
      </p>
    )}
  </div>
</header>

<style>
  /* 509-symmetry: the title, meta and subtitle are centred. No rule under the header; the space below it
     does the separating. */
  .article-head {
    padding-block: var(--space-section) var(--space-l);
    text-align: center;
  }
  .article-head__title {
    max-width: 22ch;
    margin-inline: auto;
    font-size: var(--step-6);
    text-wrap: balance;
  }
  /* A centred subtitle of two lines at most on a desktop. Longer descriptions are clamped visually only;
     the full text stays in the page. */
  .article-head__lead {
    max-width: 40em;
    margin: var(--space-s) auto 0;
    font-size: var(--step-1);
    line-height: var(--leading-lead);
    color: var(--color-text-muted);
    text-wrap: balance;
  }
  @supports (-webkit-line-clamp: 2) {
    @media (min-width: 40rem) {
      .article-head__lead {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
    }
  }
  /* Phones: the centred title and subtitle sit in a narrower measure than the body, as the intro does. */
  @media (max-width: 39.99rem) {
    .article-head__title,
    .article-head__lead {
      padding-inline: var(--space-s);
    }
  }
  .article-head__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs) var(--space-m);
    margin-top: var(--space-m);
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  /* A tonal panel with a radius, centred as a block. The words stay left-aligned: this is longer text. */
  .article-head__archived {
    max-width: var(--measure);
    margin: var(--space-m) auto 0;
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius-m);
    background: var(--color-bg-muted);
    font-size: var(--step--1);
    text-align: left;
  }
  .article-head__archived strong {
    color: var(--color-heading);
  }
</style>

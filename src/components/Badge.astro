---
/**
 * Badge (ticket 1005): a short label such as a kind, a ticket id or "phone". The tone colours the
 * edge only; the label is always text, so meaning never depends on colour.
 */
interface Props {
  label: string;
  tone?: 'neutral' | 'note' | 'tip' | 'warning';
}
const { label, tone = 'neutral' } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`]}>{label}</span>

<style>
  /* 509-symmetry: no outline. The tone is the 4px edge; a neutral badge's edge matches its fill, so it
     shows no edge at all. */
  .badge {
    --accent: var(--color-bg-muted);
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-2xs);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: var(--leading-small);
    /* Short labels stay on one line; a long one wraps inside its edge rather than widening the page. */
    max-width: 100%;
    overflow-wrap: anywhere;
    color: var(--color-text);
    background: var(--color-bg-muted);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
  }
  :global(.surface-muted) .badge {
    background: var(--color-surface);
  }
  .badge--note {
    --accent: var(--color-note);
  }
  .badge--tip {
    --accent: var(--color-tip);
  }
  .badge--warning {
    --accent: var(--color-warning);
  }
</style>

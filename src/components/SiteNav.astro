---
/**
 * The site nav (tickets 203, 206, split out of the header in 211). Two variants, because the header
 * places them either side of its tools: `desktop` is the inline list, `mobile` the menu button, a
 * <details> element so it works without JS. BaseLayout renders both into Header; a page that wants the
 * masthead without the nav (the PM desk) leaves them out, and a microsite can pass its own `items`.
 */
import { getSite } from '../lib/content';

interface Props {
  variant: 'desktop' | 'mobile';
  items?: { label: string; href: string }[];
}

const { variant } = Astro.props;
const items = Astro.props.items ?? (await getSite()).nav;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

{variant === 'desktop' ? (
  <nav aria-label="Main" class="nav nav--desktop">
    <ul>
      {items.map((item) => (
        <li>
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
) : (
  <details class="nav nav--mobile">
    <summary>
      <span class="nav__burger" aria-hidden="true" />
      <span class="visually-hidden">Menu</span>
    </summary>
    <nav aria-label="Main (mobile)">
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}

<script>
  // Progressive enhancement: Escape closes the mobile menu and returns focus.
  const menu = document.querySelector<HTMLDetailsElement>('.nav--mobile');
  menu?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .nav ul {
    list-style: none;
    padding: 0;
    display: flex;
  }
  .nav a {
    display: block;
    padding: var(--space-2xs) var(--space-xs);
    color: var(--color-nav);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-0);
  }
  .nav a:hover {
    color: var(--color-heading);
  }
  .nav a[aria-current='page'] {
    color: var(--color-text-strong);
  }
  /* Ticket 210: a hairline sweeps in under a link on hover and stays under the current page. */
  .nav--desktop a {
    position: relative;
  }
  .nav--desktop a::after {
    content: '';
    position: absolute;
    left: var(--space-xs);
    right: var(--space-xs);
    bottom: 0.15rem;
    height: 1px;
    background: currentColor;
    scale: 0 1;
    transform-origin: right;
    transition: scale var(--dur) var(--ease-out);
  }
  .nav--desktop a:hover::after,
  .nav--desktop a[aria-current='page']::after {
    scale: 1 1;
    transform-origin: left;
  }

  .nav--mobile {
    display: none;
  }
  .nav--mobile summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: var(--space-2xs);
  }
  .nav--mobile summary::-webkit-details-marker {
    display: none;
  }
  .nav__burger,
  .nav__burger::before,
  .nav__burger::after {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    position: relative;
  }
  .nav__burger::before,
  .nav__burger::after {
    content: '';
    position: absolute;
  }
  .nav__burger::before {
    top: -0.375rem;
  }
  .nav__burger::after {
    top: 0.375rem;
  }
  .nav--mobile nav {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2xs));
    z-index: 20;
    background: var(--color-bg);
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-card);
    min-width: 12rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav--mobile[open] nav {
      animation: menu-in var(--dur) var(--ease-out);
    }
    .nav__burger,
    .nav__burger::before,
    .nav__burger::after {
      transition:
        rotate var(--dur) var(--ease-out),
        top var(--dur) var(--ease-out),
        background-color var(--dur-fast);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      translate: 0 -0.5rem;
    }
  }
  /* The burger turns into a cross when the menu is open. */
  .nav--mobile[open] .nav__burger {
    background-color: transparent;
  }
  .nav--mobile[open] .nav__burger::before {
    top: 0;
    rotate: 45deg;
  }
  .nav--mobile[open] .nav__burger::after {
    top: 0;
    rotate: -45deg;
  }
  .nav--mobile ul {
    flex-direction: column;
    gap: var(--space-s);
  }

  @media (max-width: 59.99rem) {
    .nav--desktop {
      display: none;
    }
    .nav--mobile {
      display: block;
    }
  }
</style>

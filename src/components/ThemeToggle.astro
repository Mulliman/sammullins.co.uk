---
/** Theme toggle (ticket 201). Only shown once JS has run; system preference applies without JS. */
---

<button type="button" class="theme-toggle js-only" data-theme-toggle aria-pressed="false">
  <svg
    aria-hidden="true"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <path d="M12 7a5 5 0 0 0 0 10z" fill="currentColor"></path>
  </svg>
  <span class="theme-toggle__label">Dark mode</span>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  const sync = () => {
    if (!btn) return;
    btn.setAttribute('aria-pressed', String(isDark()));
  };
  btn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage blocked (private mode): the theme still applies for this page.
    }
    sync();
  });
  sync();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    background: transparent;
    border: 0;
    padding: var(--space-2xs);
    min-height: 44px;
    cursor: pointer;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--color-text-muted);
  }
  .theme-toggle:hover {
    color: var(--color-heading);
  }
  /* Small screens: icon only (the label stays for screen readers). */
  @media (max-width: 39.99rem) {
    .theme-toggle__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
  html:not(.js) .theme-toggle {
    display: none;
  }
  html.js .theme-toggle {
    display: inline-flex;
  }
</style>

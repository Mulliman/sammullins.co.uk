---
/**
 * Colophon (ticket 902): when the content last changed, and who wrote the words.
 * `sam` = written by Sam. `sam-ai` = written by Sam with AI. It describes the writing,
 * not how the page was built.
 */
import { lastChanged } from '../lib/git';
import { sourcePathFor, type AnyEntry } from '../lib/content';

interface Props {
  entry: AnyEntry;
}
const { entry } = Astro.props;
const d = entry.data;
const changed = lastChanged(entry.filePath) ?? d.updated ?? ('date' in d ? d.date : undefined);
const fmt = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const isAi = d.authorship === 'sam-ai';
const label = isAi ? 'Written by Sam, with AI' : 'Written by Sam';
const source = `https://github.com/Mulliman/sammullins.co.uk/blob/main/${sourcePathFor(entry)}`;
---

<div class="colophon">
  <span class="colophon__author" title={label}>
    <svg class="colophon__icon" aria-hidden="true" viewBox="0 0 32 32" width="22" height="22">
      <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="1.5" />
      <text
        x="16"
        y="21"
        text-anchor="middle"
        font-family="Mona Sans, system-ui, sans-serif"
        font-weight="700"
        font-size="15"
        fill="currentColor"
      >
        S
      </text>
    </svg>
    {isAi && (
      <svg class="colophon__icon colophon__icon--ai" aria-hidden="true" viewBox="0 0 32 32" width="22" height="22">
        <path
          d="M16 3 L19 13 L29 16 L19 19 L16 29 L13 19 L3 16 L13 13 Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
      </svg>
    )}
    <span>{isAi ? 'Sam + AI' : 'Sam'}</span>
    <span class="visually-hidden">: {label}.</span>
  </span>
  {changed && (
    <span>
      Last changed <time datetime={changed.toISOString()}>{fmt(changed)}</time>
    </span>
  )}
  <a href={source}>View source</a>
</div>

<style>
  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-2xs) var(--space-m);
    font-size: var(--step--1);
    color: var(--color-text-inverse-muted);
    padding-bottom: var(--space-m);
    border-bottom: 1px solid var(--color-inverse-rule);
    margin-bottom: var(--space-m);
  }
  .colophon__author {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--color-text-inverse);
  }
  .colophon__icon--ai {
    color: var(--brand-orange);
  }
</style>

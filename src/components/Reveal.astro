---
/**
 * Reveal on scroll (ticket 210). Content arrives as you reach it: a short fade and rise, staggered
 * through the items of a grid or list the way the logo's bars build. One shot per element (it doesn't
 * replay or scrub), progressive (no JS, or reduced motion, means everything is simply there) and
 * CSP-safe (a bundled module; delays are set through the CSSOM, never a style attribute).
 *
 * Only elements below the fold are hidden, so nothing above it flashes and the LCP element is never
 * held back.
 */
---

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (!reduce.matches && 'IntersectionObserver' in window) {
    // Lists whose items arrive one after another, and blocks that arrive as one piece.
    const GROUPS = [
      '.cards__grid',
      '.listing__grid',
      '.listing__list',
      '.notes',
      '.logos',
      '.timeline',
      '.steps__list',
      '.nextprev',
      '.gallery__grid',
    ];
    const SINGLES = [
      'main .section > :is(.container, .container--narrow) > :not(.cards__grid, .listing__grid, .listing__list, .notes, .logos, .timeline, .split)',
      'main .nested-block:not(:has(.cards__grid, .listing__grid, .listing__list, .notes, .logos, .timeline, .steps__list, .nextprev))',
      'main .split__col',
      'main .entry-body > *',
    ];
    const fold = innerHeight * 0.92;
    const targets = new Set<HTMLElement>();
    const add = (el: HTMLElement, i = 0) => {
      if (targets.has(el) || el.closest('.hero, [data-no-reveal]')) return;
      if (el.getBoundingClientRect().top < fold) return; // already on screen: leave it be
      el.style.setProperty('--reveal-delay', `${Math.min(i, 6) * 80}ms`);
      el.dataset.reveal = '';
      targets.add(el);
    };
    document.querySelectorAll<HTMLElement>(GROUPS.join(',')).forEach((list) => {
      // Items on the same row share a stagger; each new row starts again, so a long list never lags.
      let rowTop = -1;
      let i = 0;
      [...list.children].forEach((child) => {
        const top = Math.round(child.getBoundingClientRect().top);
        i = top === rowTop ? i + 1 : 0;
        rowTop = top;
        add(child as HTMLElement, i);
      });
    });
    document.querySelectorAll<HTMLElement>(SINGLES.join(',')).forEach((el) => add(el));

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          (e.target as HTMLElement).dataset.reveal = 'in';
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    targets.forEach((el) => io.observe(el));
    document.documentElement.classList.add('reveal-ready');
  }
</script>

---
/**
 * Console greeting and hidden "terminal green" theme (ticket 903).
 * Bundled script only (no inline JS, no eval). Not a security mechanism: nothing sensitive sits behind it.
 * The code is in public/humans.txt.
 */
import '../styles/themes/terminal.css';
---

<script>
  const KEY = 'sm-secret';
  const CODE = 'pelican';
  const REPO = 'https://github.com/Mulliman/sammullins.co.uk';
  const root = document.documentElement;
  const w = window as unknown as { unlock: (code: string) => string; lock: () => string; __smGreeted?: boolean };

  const store = {
    get: (): string | null => {
      try {
        return sessionStorage.getItem(KEY);
      } catch {
        return null;
      }
    },
    set: (v: string | null): void => {
      try {
        if (v) sessionStorage.setItem(KEY, v);
        else sessionStorage.removeItem(KEY);
      } catch {
        /* storage blocked */
      }
    },
  };
  /** A theme token's current value, so console styling follows the theme too. */
  const token = (name: string): string => getComputedStyle(root).getPropertyValue(name).trim();
  const apply = (on: boolean): void => {
    if (on) root.dataset.secret = 'terminal';
    else delete root.dataset.secret;
  };

  if (!w.__smGreeted) {
    w.__smGreeted = true;
    const art = ['  ___ __  __', ' / __|  \\/  |', ' \\__ \\ |\\/| |', ' |___/_|  |_|'].join('\n');
    console.log('%c' + art, `color:${token('--brand-orange')};font-family:monospace;font-weight:bold;line-height:1.2`);
    console.log(
      '%cBuilt with Claude Code, reviewed by a human. Source: ' +
        REPO +
        '\nAGENTS.md: ' +
        REPO +
        '/blob/main/AGENTS.md' +
        '\nThere is a clue in /humans.txt. Then try unlock() with what you find.',
      'color:inherit;font-family:monospace',
    );
  }

  w.unlock = (code: string): string => {
    if (String(code).trim().toLowerCase() !== CODE) {
      return 'Nope. Have another look at the humans, they know more than they let on.';
    }
    store.set('terminal');
    apply(true);
    console.log(
      '%cCongratulations, terminal mode is on for this session. lock() turns it off.',
      `color:${token('--color-text')};background:${token('--color-bg')};padding:2px 4px`,
    );
    return 'Unlocked: terminal mode for this session. Call lock() to switch back.';
  };

  w.lock = (): string => {
    store.set(null);
    apply(false);
    return 'Locked. Back to the usual colours.';
  };

  if (store.get() === 'terminal') apply(true);
</script>

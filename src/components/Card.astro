---
/**
 * Card (ticket 305): one card in `full`, `image` or `text` style.
 * The title link is the only link. Its ::after covers the whole card, so the whole card is
 * clickable without nesting links. Links inside the text sit above that cover.
 */
import Pic from './Pic.astro';
import { md } from '../lib/markdown';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  text?: string | undefined;
  image?: { src: ImageMetadata; alt: string; decorative: boolean } | undefined;
  href?: string | undefined;
  date?: Date | undefined;
  variant?: 'full' | 'image' | 'text';
}

const { title, text, image, href, date, variant = 'full' } = Astro.props;
// An image card with no image falls back to the text style.
const kind = variant === 'image' && !image ? 'text' : variant;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<article class:list={['card', `card--${kind}`]}>
  {image && kind !== 'text' && (
    <div class="card__media">
      <Pic src={image.src} alt={image.decorative ? '' : image.alt} preset="card" class="card__img" />
    </div>
  )}
  <div class:list={[kind === 'image' ? 'card__overlay' : 'card__body']}>
    <h3 class="card__title">
      {href ? (
        <a class="card__link" href={href}>
          {title}
        </a>
      ) : (
        title
      )}
    </h3>
    {kind !== 'image' && date && (
      <p class="card__meta">
        <time datetime={iso(date)}>{fmt(date)}</time>
      </p>
    )}
    {kind !== 'image' && text && <div class="card__text" set:html={md(text)} />}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    border-radius: var(--radius);
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .card--text {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-m);
  }
  .card--full {
    background: transparent;
  }

  /* Image style: the bar sits on the image. Both share one grid cell, so the title link's
     ::after still covers the whole card (an absolutely positioned bar would become its own
     containing block). */
  .card--image {
    display: grid;
    overflow: hidden;
    color: #fff;
    background: #000;
  }
  .card--image > .card__media,
  .card--image > .card__overlay {
    grid-area: 1 / 1;
  }
  .card__overlay {
    align-self: end;
    padding: var(--space-xs) var(--space-s);
    background: rgb(0 0 0 / 0.72);
  }

  /* Full style: thick white photo frame. */
  .card__media {
    border: 10px solid var(--color-frame);
    box-shadow: var(--shadow);
  }
  .card--image .card__media {
    border: 0;
    box-shadow: none;
  }
  .card__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-top: var(--space-s);
  }
  .card--text .card__body {
    padding-top: 0;
  }

  .card__title {
    font-size: var(--step-1);
    font-weight: 300;
    line-height: 1.25;
    margin: 0;
  }
  .card--image .card__title {
    color: #fff;
  }

  .card__link {
    color: inherit;
    text-decoration: none;
  }
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card__link:focus-visible {
    outline: none;
  }
  .card:hover .card__link {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .card__meta {
    margin: 0;
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }
  .card__text {
    color: var(--color-text-muted);
  }
  .card__text :global(p) {
    margin: 0;
  }
  .card__text :global(p + p) {
    margin-top: 0.75em;
  }
  .card__text :global(a) {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-soft);
    }
  }
  .card:focus-within:has(:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }
</style>

---
/**
 * Card (ticket 305): one card in `full`, `image` or `text` style.
 * The title link is the only link. Its ::after covers the whole card, so the whole card is
 * clickable without nesting links. Links inside the text sit above that cover.
 */
import Pic from './Pic.astro';
import Rosette from './Rosette.astro';
import { md } from '../lib/markdown';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  text?: string | undefined;
  image?: { src: ImageMetadata; alt: string; decorative: boolean } | undefined;
  href?: string | undefined;
  date?: Date | undefined;
  cta?: string | undefined;
  /** An award rosette in the card's top corner (ticket 509). */
  award?: { label: string; title: string; detail?: string | undefined } | undefined;
  variant?: 'full' | 'image' | 'text' | 'row';
  /** h2 when nothing above the card grid is a heading (keeps heading order valid); h3 otherwise. */
  headingLevel?: 2 | 3;
}

const { title, text, image, href, date, cta, award, variant = 'full', headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
// An image card with no image falls back to the text style.
const kind = variant === 'image' && !image ? 'text' : variant;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<article class:list={['card', `card--${kind}`, { 'card--award': award }]}>
  {award && (
    <div class="card__award">
      <Rosette {...award} />
    </div>
  )}
  {image && kind !== 'text' && (
    <div class="card__media">
      <Pic src={image.src} alt={image.decorative ? '' : image.alt} preset="card" class="card__img" />
    </div>
  )}
  <div class:list={[kind === 'image' ? 'card__overlay' : 'card__body']}>
    <Heading class="card__title">
      {href ? (
        <a class="card__link" href={href}>
          {title}
        </a>
      ) : (
        title
      )}
    </Heading>
    {kind !== 'image' && date && (
      <p class="card__meta">
        <time datetime={iso(date)}>{fmt(date)}</time>
      </p>
    )}
    {kind !== 'image' && text && <div class="card__text" set:html={md(text)} />}
    {kind !== 'image' && href && cta && (
      <p class="card__cta" aria-hidden="true">
        <span class="arrow-link">{cta}</span>
      </p>
    )}
  </div>
</article>

<style>
  /* Ticket 210: smaller, calmer cards. Left-aligned, a hairline edge instead of a white slab, a 16:9
     image, a quiet arrow link instead of a button, and a lift on hover. On a phone a full card becomes a
     row (thumbnail beside the text), so a list of cards reads as a list instead of a screen per card. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    border-radius: var(--radius-m);
    text-align: left;
  }

  /* Award (ticket 509): the rosette sits in the top corner, over the image on a stacked card and beside
     the text on a feature card, which keeps room for it. */
  .card__award {
    --rosette-size: 7.5rem;
    position: absolute;
    width: var(--rosette-size);
    top: var(--space-xs);
    right: var(--space-xs);
    z-index: 2;
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .card__award {
      --rosette-size: 8.5rem;
      top: var(--space-s);
      right: var(--space-m);
    }
  }
  @media (min-width: 960px) {
    :global(.cards__item:only-child) > .card--full.card--award .card__body {
      padding-right: calc(8.5rem + var(--space-l));
    }
  }

  /* Full: image on top, then title, meta, text and the call to action pinned to the bottom. */
  /* 509-symmetry: no hairline edges. Cards sit on a soft shadow (and a lighter surface in dark mode). */
  .card--full {
    background: var(--color-surface);
    box-shadow: var(--shadow-card-rest);
    overflow: hidden;
  }
  .card--full .card__media {
    background: var(--color-bg-muted);
  }
  .card--full .card__media :global(img),
  .card--image .card__media :global(img),
  .card--row .card__media :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform var(--dur) var(--ease-out);
  }
  .card:has(.card__link):hover .card__media :global(img) {
    transform: scale(1.03);
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    flex: 1;
    padding: var(--space-s-m);
  }

  /* Row: compact horizontal editorial showcase card (thumbnail beside full summary). On phones the
     thumbnail keeps its 16:9 ratio beside the text so wide banners aren't cropped into squares. */
  .card--row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-xs);
    padding: var(--space-xs);
    background: var(--color-surface);
    box-shadow: var(--shadow-card-rest);
    overflow: hidden;
  }
  .card--row:not(:has(.card__media)) {
    grid-template-columns: minmax(0, 1fr);
    padding: var(--space-xs) var(--space-s);
  }
  .card--row .card__media {
    border-radius: var(--radius);
    background: var(--color-bg-muted);
  }
  .card--row .card__media :global(:is(picture, img)) {
    height: auto;
  }
  .card--row .card__body {
    justify-content: center;
    padding: 0;
    gap: var(--space-3xs);
  }
  .card--row .card__title {
    font-size: var(--step-0);
  }
  @media (min-width: 48rem) {
    .card--row {
      grid-template-columns: minmax(9.5rem, 34%) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-s);
      padding: var(--space-xs);
    }
    .card--row .card__body {
      padding: var(--space-2xs) var(--space-xs) var(--space-2xs) 0;
      gap: var(--space-2xs);
    }
    .card--row .card__title {
      font-size: var(--step-1);
    }
  }

  /* Text: no box and no rule (509-symmetry); the grid's gap separates one entry from the next. */
  .card--text {
    border-radius: 0;
  }
  .card--text .card__body {
    padding: 0;
  }

  /* Image: the title sits on the photo, in a bar along the bottom. Both share one grid cell, so the
     title link's ::after still covers the whole card. */
  .card--image {
    display: grid;
    overflow: hidden;
    color: var(--color-on-media);
    background: var(--color-media-bg);
  }
  .card--image > .card__media,
  .card--image > .card__overlay {
    grid-area: 1 / 1;
  }
  .card__overlay {
    align-self: end;
    padding: var(--space-xs) var(--space-s);
    background: var(--color-media-scrim-soft);
  }

  .card__media {
    overflow: hidden;
  }
  .card__media :global(picture) {
    display: block;
  }

  .card__title {
    font-size: var(--step-1);
    line-height: var(--leading-heading);
    margin: 0;
    text-wrap: balance;
  }
  .card--image .card__title {
    color: var(--color-on-media);
    font-size: var(--step-0);
  }
  .card__link {
    color: inherit;
    text-decoration: none;
  }
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card__link:focus-visible {
    outline: none;
  }

  .card__meta {
    margin: 0;
    font-size: var(--step--1);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .card__text {
    font-size: var(--step--1);
    line-height: var(--leading-small);
    color: var(--color-text-muted);
  }
  /* A card with no link, or a text-only card, is the content itself (a CV entry, a skill), so it reads at
     body size. */
  .card:not(:has(.card__link)) .card__text,
  .card--text .card__text {
    font-size: var(--step-0);
    line-height: var(--leading-body);
  }
  /* Only a linked card trims its summary (the page it links to has the rest). A card without a link,
     such as a CV entry, always shows all of its text. */
  .card--full:has(.card__link) .card__text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }
  .card__text :global(p) {
    margin: 0;
  }
  .card__text :global(p + p) {
    margin-top: 0.75em;
  }
  .card__text :global(a) {
    position: relative;
    z-index: 2;
  }
  .card__cta {
    margin: auto 0 0;
    padding-top: var(--space-2xs);
  }

  /* Hover and focus: the edge firms up and the call to action underlines. No lift, no shadow. */
  .card:has(.card__link) {
    transition: box-shadow var(--dur) var(--ease-out);
  }
  .card--full:has(.card__link):hover,
  .card--row:has(.card__link):hover {
    box-shadow: var(--shadow-card);
  }
  .card--row:has(.card__link):hover .card__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .card--text:has(.card__link):hover .card__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .card:focus-within:has(:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  /* Touch: a press gives feedback, since there is no hover. */
  .card:has(.card__link):active {
    box-shadow: var(--shadow-card);
  }

  /* A lone full card in a multi-column grid becomes a feature: image beside the text. */
  @media (min-width: 960px) {
    :global(.cards__item:only-child) > .card--full {
      flex-direction: row;
    }
    :global(.cards__item:only-child) > .card--full .card__media {
      flex: 0 0 min(50%, 30rem);
    }
    :global(.cards__item:only-child) > .card--full .card__media :global(:is(picture, img)) {
      height: 100%;
    }
    :global(.cards__item:only-child) > .card--full .card__body {
      justify-content: center;
      padding: var(--space-m-l);
    }
    :global(.cards__item:only-child) > .card--full .card__title {
      font-size: var(--step-2);
    }
    :global(.cards__item:only-child) > .card--full .card__text {
      font-size: var(--step-0);
      line-height: var(--leading-body);
      -webkit-line-clamp: 6;
      line-clamp: 6;
    }
  }

  /* Tablets (640px to 959px): the feature card is a row like the cards under it, so its banner doesn't
     fill the screen; the rosette keeps a corner of the text side. */
  @media (min-width: 640px) and (max-width: 959.98px) {
    :global(.cards__item:only-child) > .card--full:has(.card__media) {
      display: grid;
      grid-template-columns: minmax(9.5rem, 34%) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-s);
      padding: var(--space-xs);
    }
    :global(.cards__item:only-child) > .card--full .card__media {
      border-radius: var(--radius);
    }
    :global(.cards__item:only-child) > .card--full .card__body {
      padding: var(--space-2xs) var(--space-xs) var(--space-2xs) 0;
    }
    :global(.cards__item:only-child) > .card--full.card--award .card__body {
      padding-right: calc(7rem + var(--space-s));
    }
    :global(.cards__item:only-child) > .card--award .card__award {
      --rosette-size: 7rem;
    }
  }

  /* Phones: a full card in a multi-card grid is a row, thumbnail on the left. A lone feature card
     stays stacked with its full-width 16:9 banner on top so it keeps its hierarchy. */
  @media (max-width: 639.98px) {
    :global(:is(.cards__item, .listing__cell):not(:only-child)) > .card--full:has(.card__media) {
      display: grid;
      grid-template-columns: 7.5rem minmax(0, 1fr);
      align-items: start;
      padding: var(--space-xs);
      gap: var(--space-xs);
    }
    :global(:is(.cards__item, .listing__cell):not(:only-child)) > .card--full .card__media {
      border: 0;
      border-radius: var(--radius);
    }
    :global(:is(.cards__item, .listing__cell):not(:only-child)) > .card--full .card__body {
      padding: 0;
      gap: var(--space-3xs);
    }
    :global(:is(.cards__item, .listing__cell):not(:only-child)) > .card--full:not(:has(.card__media)) .card__body {
      padding: var(--space-xs) var(--space-s);
    }
    :global(:is(.cards__item, .listing__cell):not(:only-child)) > .card--full .card__title {
      font-size: var(--step-0);
    }
    :global(:is(.cards__item, .listing__cell):not(:only-child)) > .card--full:has(.card__link) .card__text {
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
  }
</style>

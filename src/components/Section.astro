---
/**
 * Standard block wrapper: a full-width section with a surface colour and a container.
 * When `nested` (inside a `section` block or a split column) it renders only the inner content,
 * keeping the narrow text column for narrow blocks.
 */
interface Props {
  nested?: boolean;
  surface?: 'default' | 'muted' | 'inverse';
  width?: 'normal' | 'narrow';
  tight?: boolean;
  class?: string;
  label?: string;
}
const { nested = false, surface = 'default', width = 'normal', tight = false, class: cls = '', label } = Astro.props;
---

{nested ? (
  <div class:list={['nested-block', { 'nested-block--narrow': width === 'narrow' }, cls]}>
    <slot />
  </div>
) : (
  <section class:list={['section', `surface-${surface}`, { 'section--tight': tight }, cls]} aria-label={label}>
    <div class={width === 'narrow' ? 'container--narrow' : 'container'}>
      <slot />
    </div>
  </section>
)}

<style>
  .nested-block--narrow {
    max-width: var(--container-narrow);
    margin-inline: auto;
  }
  /* Components inside one section: the original's grid margin between stacked items. */
  .nested-block + .nested-block {
    margin-top: var(--space-m);
  }
  /* After an intro with body text, leave the original's full section gap before what follows. */
  .nested-block:has(:global(.intro__lead)) + .nested-block {
    margin-top: var(--space-xl);
  }
  /* A lone button (an intro with only a call to action) gets breathing room above it. */
  .nested-block + .nested-block:has(:global(.intro__cta)):not(:has(:global(.intro__heading))) {
    margin-top: var(--space-l);
  }
</style>

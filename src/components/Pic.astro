---
/**
 * Responsive picture (ticket 402): AVIF + WebP from the AVIF master, no JPEG.
 * Size presets keep `sizes` honest so the browser picks a sensible width.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const presets = {
  thumb: { widths: [240, 480], sizes: '(min-width: 640px) 240px, 50vw' },
  card: { widths: [400, 600, 800, 1200], sizes: '(min-width: 1200px) 380px, (min-width: 640px) 45vw, 100vw' },
  content: { widths: [600, 900, 1200, 1600], sizes: '(min-width: 900px) 832px, 100vw' },
  wide: { widths: [800, 1200, 1600, 2000], sizes: '(min-width: 1200px) 1152px, 100vw' },
  full: { widths: [800, 1200, 1600, 2000, 2400], sizes: '100vw' },
  half: { widths: [400, 600, 900, 1200], sizes: '(min-width: 1200px) 590px, (min-width: 640px) 48vw, 100vw' },
  logo: { widths: [240, 480], sizes: '(min-width: 960px) 230px, (min-width: 640px) 18vw, 40vw' },
  // A blurred, darkened backdrop shows no detail, so one tiny file does (the browser scales it up).
  backdrop: { widths: [160], sizes: '100vw' },
} as const;

interface Props {
  src: ImageMetadata;
  alt: string;
  preset?: keyof typeof presets;
  /** LCP image: eager + high fetch priority. Decoding stays async: sync decoding blocked the main thread
      for 177ms on CI's home page (ticket 804 budget). */
  priority?: boolean;
  class?: string;
  pictureClass?: string;
}

const { src, alt, preset = 'content', priority = false, class: cls, pictureClass } = Astro.props;
const p = presets[preset];
const widths: number[] = p.widths.filter((w) => w <= src.width);
if (widths.length === 0) widths.push(src.width);
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  widths={widths}
  sizes={p.sizes}
  loading={priority ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={priority ? 'high' : 'auto'}
  class={cls}
  pictureAttributes={{ class: pictureClass }}
/>

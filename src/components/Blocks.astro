---
/**
 * Block renderer (ticket 102): renders a page's blocks in order.
 * Adding a block type to the schema without adding it here is a type error (exhaustive switch).
 */
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { Block } from '../lib/content';
import Hero from '../blocks/Hero.astro';
import Intro from '../blocks/Intro.astro';
import Prose from '../blocks/Prose.astro';
import Callout from '../blocks/Callout.astro';
import ImageBlock from '../blocks/Image.astro';
import Gallery from '../blocks/Gallery.astro';
import Cards from '../blocks/Cards.astro';
import Listing from '../blocks/Listing.astro';
import LogoWall from '../blocks/LogoWall.astro';
import Quote from '../blocks/Quote.astro';
import Code from '../blocks/Code.astro';
import NextPrev from '../blocks/NextPrev.astro';
import Timeline from '../blocks/Timeline.astro';
import Embed from '../blocks/Embed.astro';
import Split from '../blocks/Split.astro';
import BodySection from '../blocks/Body.astro';
import SectionBlock from '../blocks/SectionBlock.astro';

interface Props {
  blocks: Block[];
  /** Rendered Markdown body component for `body` blocks. */
  Content?: AstroComponentFactory | undefined;
  /** Nested inside a section or split column: blocks render without their own section wrapper. */
  nested?: boolean;
}

const { blocks, Content, nested = false } = Astro.props;

function assertNever(x: never): never {
  throw new Error(`Unknown block type: ${JSON.stringify(x)}`);
}
---

{blocks.map((block) => {
  switch (block.type) {
    case 'hero':
      return <Hero block={block} />;
    case 'intro':
      return <Intro block={block} nested={nested} />;
    case 'prose':
      return <Prose block={block} nested={nested} />;
    case 'body':
      return <BodySection block={block} Content={Content} nested={nested} />;
    case 'callout':
      return <Callout block={block} nested={nested} />;
    case 'image':
      return <ImageBlock block={block} nested={nested} />;
    case 'gallery':
      return <Gallery block={block} nested={nested} />;
    case 'cards':
      return <Cards block={block} nested={nested} />;
    case 'listing':
      return <Listing block={block} nested={nested} />;
    case 'logoWall':
      return <LogoWall block={block} nested={nested} />;
    case 'quote':
      return <Quote block={block} nested={nested} />;
    case 'code':
      return <Code block={block} nested={nested} />;
    case 'nextPrev':
      return <NextPrev block={block} nested={nested} />;
    case 'timeline':
      return <Timeline block={block} nested={nested} />;
    case 'embed':
      return <Embed block={block} nested={nested} />;
    case 'split':
      return <Split block={block} Content={Content} />;
    case 'section':
      return <SectionBlock block={block} Content={Content} />;
    default:
      return assertNever(block);
  }
})}

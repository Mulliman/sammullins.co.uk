---
/**
 * Agent view (ticket 901): flips the page into what an LLM sees (the Markdown twin).
 * Shown rendered by default, with a switch to the raw Markdown. The Markdown renderer is
 * loaded only when the view is opened. Without JS it is a plain link to index.md.
 */
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<div class="agent-view">
  <a class="no-js-only" href={href}>
    View this page as Markdown (what an agent sees)
  </a>
  <button type="button" class="agent-view__toggle js-only" data-agent-toggle data-href={href} aria-pressed="false">
    <span aria-hidden="true">⌘</span> Agent view
  </button>
</div>

<template id="agent-view-panel">
  <section class="agent-panel" aria-label="Agent view: this page as Markdown">
    <div class="container">
      <div class="agent-panel__bar">
        <p>
          <strong>Agent view.</strong> This is the Markdown an AI agent gets for this page (<code>index.md</code>).
        </p>
        <div class="agent-panel__actions">
          <div class="agent-panel__modes" role="group" aria-label="Display">
            <button type="button" data-agent-mode="rendered" aria-pressed="true">
              Rendered
            </button>
            <button type="button" data-agent-mode="raw" aria-pressed="false">
              Markdown
            </button>
          </div>
          <button type="button" data-agent-copy>
            Copy
          </button>
          <a data-agent-raw href={href}>
            Open raw
          </a>
          <button type="button" data-agent-close>
            Back to human view
          </button>
        </div>
      </div>
      <div class="agent-panel__doc" tabindex="-1">
        <dl class="agent-panel__meta" hidden></dl>
        <div class="agent-panel__rendered"></div>
        <pre class="agent-panel__md" hidden><code></code></pre>
      </div>
      <p class="agent-panel__status visually-hidden" aria-live="polite"></p>
    </div>
  </section>
</template>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-agent-toggle]');
  const main = document.getElementById('content');
  let panel: HTMLElement | null = null;

  const escapeHtml = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  /** Splits simple `key: value` YAML front matter from the body. */
  function splitFrontMatter(text: string): { meta: [string, string][]; body: string } {
    const m = text.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?/);
    if (!m) return { meta: [], body: text };
    const meta = m[1]!
      .split(/\r?\n/)
      .map((line) => line.match(/^([\w-]+):\s*(.*)$/))
      .filter((x): x is RegExpMatchArray => x !== null)
      .map((x) => [x[1]!, x[2]!.replace(/^"(.*)"$/, '$1')] as [string, string]);
    return { meta, body: text.slice(m[0].length) };
  }

  /** Renders the twin's Markdown. Raw HTML is escaped (as on the server); images become labelled
   *  links, because the alt text is what an agent actually reads (and it avoids loading full-size images). */
  async function render(body: string): Promise<string> {
    const { Marked } = await import('marked');
    const marked = new Marked({
      gfm: true,
      renderer: {
        html({ text }) {
          return escapeHtml(text);
        },
        image({ href, text }) {
          return `<a class="agent-img" href="${escapeHtml(href)}">Image: ${escapeHtml(text || 'no alt text')}</a>`;
        },
      },
    });
    return marked.parse(body, { async: false });
  }

  function setMode(mode: 'rendered' | 'raw') {
    if (!panel) return;
    panel.querySelector<HTMLElement>('.agent-panel__rendered')!.hidden = mode !== 'rendered';
    panel.querySelector<HTMLElement>('.agent-panel__meta')!.hidden =
      mode !== 'rendered' || !panel.querySelector('.agent-panel__meta')!.childElementCount;
    panel.querySelector<HTMLElement>('.agent-panel__md')!.hidden = mode !== 'raw';
    panel.querySelectorAll<HTMLButtonElement>('[data-agent-mode]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.agentMode === mode));
    });
  }

  async function open() {
    if (!btn || !main) return;
    const href = btn.dataset.href!;
    const res = await fetch(href);
    const text = res.ok ? await res.text() : 'Could not load the Markdown version.';
    const tpl = document.getElementById('agent-view-panel') as HTMLTemplateElement;
    panel = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;

    panel.querySelector('.agent-panel__md code')!.textContent = text;
    const { meta, body } = splitFrontMatter(text);
    const dl = panel.querySelector('.agent-panel__meta')!;
    for (const [k, v] of meta) {
      const dt = document.createElement('dt');
      dt.textContent = k;
      const dd = document.createElement('dd');
      dd.textContent = v;
      dl.append(dt, dd);
    }
    try {
      panel.querySelector('.agent-panel__rendered')!.innerHTML = await render(body);
    } catch {
      // Renderer failed to load (offline?): fall back to the raw Markdown.
      panel.querySelector('.agent-panel__rendered')!.textContent = '';
    }

    panel.querySelector<HTMLAnchorElement>('[data-agent-raw]')!.href = href;
    panel.querySelector('[data-agent-close]')!.addEventListener('click', close);
    panel
      .querySelectorAll<HTMLButtonElement>('[data-agent-mode]')
      .forEach((b) => b.addEventListener('click', () => setMode(b.dataset.agentMode === 'raw' ? 'raw' : 'rendered')));
    panel.querySelector('[data-agent-copy]')!.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
        panel!.querySelector('.agent-panel__status')!.textContent = 'Markdown copied to clipboard';
      } catch {
        // Clipboard blocked: the Markdown view is still there to copy by hand.
      }
    });

    main.querySelectorAll<HTMLElement>(':scope > *').forEach((el) => (el.hidden = true));
    main.prepend(panel);
    setMode(panel.querySelector('.agent-panel__rendered')!.childElementCount ? 'rendered' : 'raw');
    document.documentElement.classList.add('agent-mode');
    btn.setAttribute('aria-pressed', 'true');
    panel.querySelector<HTMLElement>('.agent-panel__doc')!.focus();
    window.scrollTo({ top: 0 });
  }

  function close() {
    if (!main || !btn) return;
    panel?.remove();
    panel = null;
    main.querySelectorAll<HTMLElement>(':scope > *').forEach((el) => (el.hidden = false));
    document.documentElement.classList.remove('agent-mode');
    btn.setAttribute('aria-pressed', 'false');
    btn.focus();
  }

  btn?.addEventListener('click', () => (panel ? close() : open()));
</script>

<style>
  .agent-view {
    text-align: center;
    margin-bottom: var(--space-s);
    font-size: var(--step--1);
  }
  .agent-view a {
    color: var(--color-link-inverse);
  }
  .agent-view__toggle {
    font-family: var(--font-mono);
    background: transparent;
    color: var(--color-text-inverse);
    border: 1px dashed var(--brand-orange);
    border-radius: var(--radius);
    padding: 0.3rem 0.8rem;
    cursor: pointer;
  }
  .agent-view__toggle[aria-pressed='true'] {
    background: var(--brand-orange);
    color: var(--color-on-brand);
  }
  :global(.agent-panel) {
    padding-block: var(--space-l);
    background: var(--color-bg-muted);
  }
  :global(.agent-panel__bar) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-s);
  }
  :global(.agent-panel__actions) {
    display: flex;
    gap: var(--space-2xs);
    flex-wrap: wrap;
  }
  :global(.agent-panel__modes) {
    display: inline-flex;
    margin-right: var(--space-xs);
  }
  :global(.agent-panel__actions button),
  :global(.agent-panel__actions a) {
    font: inherit;
    font-size: var(--step--1);
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: var(--radius);
    cursor: pointer;
    text-decoration: none;
  }
  :global(.agent-panel__modes button) {
    border-radius: 0;
  }
  :global(.agent-panel__modes button + button) {
    border-left: 0;
  }
  :global(.agent-panel__modes button[aria-pressed='true']) {
    background: var(--color-heading);
    border-color: var(--color-heading);
    color: var(--color-bg);
  }

  /* The document: a plain, left-aligned reading view, deliberately unlike the designed page. */
  :global(.agent-panel__doc) {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-m) var(--space-l);
    max-width: 52rem;
    margin-inline: auto;
  }
  :global(.agent-panel__meta) {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.2rem var(--space-s);
    margin: 0 0 var(--space-m);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  :global(.agent-panel__meta dt) {
    font-weight: 700;
  }
  :global(.agent-panel__meta dd) {
    margin: 0;
    overflow-wrap: anywhere;
  }
  :global(.agent-panel__rendered) {
    overflow-wrap: anywhere;
  }
  :global(.agent-panel__rendered > * + *) {
    margin-top: 0.9em;
  }
  :global(.agent-panel__rendered :is(h1, h2, h3, h4)) {
    font-family: var(--font-sans);
    font-weight: 700;
    text-transform: none;
    text-align: left;
    color: var(--color-text-strong);
    line-height: 1.3;
    margin-top: 1.4em;
  }
  :global(.agent-panel__rendered h1) {
    font-size: 1.75rem;
    margin-top: 0;
  }
  :global(.agent-panel__rendered h2) {
    font-size: 1.35rem;
    padding-bottom: 0.2em;
    border-bottom: 1px solid var(--color-border);
  }
  :global(.agent-panel__rendered h3) {
    font-size: 1.1rem;
  }
  :global(.agent-panel__rendered :is(ul, ol)) {
    padding-left: 1.4em;
  }
  :global(.agent-panel__rendered li + li) {
    margin-top: 0.3em;
  }
  :global(.agent-panel__rendered pre) {
    white-space: pre-wrap;
  }
  :global(.agent-panel__rendered blockquote) {
    border-left: 4px solid var(--color-border);
    padding-left: var(--space-s);
    color: var(--color-text-muted);
  }
  :global(.agent-img) {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.15rem 0.5rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
  }
  :global(.agent-panel__md) {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    white-space: pre-wrap;
    word-break: break-word;
    margin: 0;
  }
</style>

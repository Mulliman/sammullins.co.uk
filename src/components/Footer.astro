---
/**
 * Site footer (tickets 203, 206): one sign-off line, the nav, socials (rel="me"), the agent view toggle
 * (passed in by entry pages through the `actions` slot; moved back from the header in ticket 209), the colophon slot
 * and the copyright. The bio cards are gone (ticket 206): that copy lives on the home page (508).
 */
import Logo from './Logo.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const year = new Date().getFullYear();
---

<footer class="site-footer surface-inverse">
  <div class="container site-footer__inner">
    <p class="signoff">
      <span class="footer-logo">
        <Logo lockup="stacked" />
      </span>
      <span>
        {site.name} · {site.tagline}
      </span>
    </p>

    <nav aria-label="Footer" class="footer-nav">
      <ul>
        {[...site.nav, ...site.footerLinks].map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <ul class="socials" aria-label="Find me">
      {site.socials.map((s) => (
        <li>
          <a href={s.href} rel="me noopener">
            <span class="socials__label">{s.label}</span>
            <span class="socials__handle">{s.handle}</span>
          </a>
        </li>
      ))}
    </ul>

    <slot name="actions" />
    <slot name="colophon" />

    <p class="copyright">
      &copy; {site.name} {year}. Words and pictures all rights reserved.{' '}
      <a href="https://github.com/Mulliman/sammullins.co.uk">Site source</a> (MIT).
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-l-xl) var(--space-m);
    margin-top: auto;
  }
  .site-footer__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    text-align: center;
  }
  .signoff {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-text-inverse);
    font-weight: var(--weight-strong);
  }
  .footer-logo {
    width: 7rem;
    display: block;
  }
  .footer-logo :global(svg) {
    width: 100%;
    height: auto;
  }
  .footer-nav ul,
  .socials {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs) var(--space-m);
  }
  .footer-nav a {
    color: var(--color-text-inverse);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    text-decoration: none;
  }
  .footer-nav a:hover {
    text-decoration: underline;
  }
  .socials {
    font-size: var(--step--1);
  }
  .socials a {
    display: inline-flex;
    gap: 0.4em;
    text-decoration: none;
  }
  .socials__label {
    color: var(--color-text-inverse);
  }
  .socials__handle {
    color: var(--color-link);
  }
  .socials a:hover .socials__handle {
    text-decoration: underline;
  }
  .copyright {
    font-size: var(--step--1);
    color: var(--color-text-inverse-muted);
  }
</style>

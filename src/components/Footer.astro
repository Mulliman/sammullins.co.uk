---
/**
 * Site footer (ticket 203): nav, the card grid from the original site, socials (rel="me"),
 * archive/photography links and the colophon slot.
 */
import logo from '../assets/brand/logo.svg?raw';
import { getSite } from '../lib/content';
import { md } from '../lib/markdown';

const site = await getSite();
const year = new Date().getFullYear();
---

<footer class="site-footer surface-inverse">
  <div class="container">
    <slot name="colophon" />

    <nav aria-label="Footer" class="footer-nav">
      <ul>
        {[...site.nav, ...site.footerLinks].map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer-cards">
      <div class="footer-card footer-card--logo">
        <span class="footer-logo" aria-hidden="true" set:html={logo} />
      </div>
      {site.footerCards.map((card) => (
        <div class="footer-card">
          <h2 class="footer-card__title">{card.title}</h2>
          <Fragment set:html={md(card.body)} />
        </div>
      ))}
      <div class="footer-card">
        <h2 class="footer-card__title">Find me</h2>
        <ul class="socials">
          {site.socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener">
                <span class="socials__label">{s.label}</span>
                <span class="socials__handle">{s.handle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="copyright">
      &copy; {site.name} {year}. Words and pictures all rights reserved.
      <a href="https://github.com/Mulliman/sammullins.co.uk">Site source</a> (MIT).
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-l) var(--space-m);
    margin-top: auto;
  }
  .footer-nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s) var(--space-m);
  }
  .footer-nav a {
    color: var(--color-text-inverse);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--step--1);
    text-decoration: none;
  }
  .footer-nav a:hover {
    text-decoration: underline;
  }
  .footer-cards {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    text-align: center;
  }
  .footer-card {
    background: var(--color-surface-inverse);
    padding: var(--space-m);
    color: var(--color-text-inverse-muted);
    font-size: var(--step--1);
  }
  .footer-card :global(p + p) {
    margin-top: 0.75em;
  }
  .footer-card--logo {
    display: grid;
    place-items: center;
    color: var(--color-text-inverse);
  }
  .footer-logo {
    width: 140px;
    display: block;
  }
  .footer-logo :global(svg) {
    width: 100%;
    height: auto;
  }
  .footer-card__title {
    font-size: var(--step-1);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-inverse);
    margin-bottom: var(--space-xs);
  }
  .socials {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }
  .socials a {
    display: flex;
    justify-content: center;
    gap: 0.5em;
    text-decoration: none;
  }
  .socials__label {
    color: var(--color-text-inverse);
  }
  .socials__handle {
    color: var(--color-link);
  }
  .socials a:hover .socials__handle {
    text-decoration: underline;
  }
  .copyright {
    text-align: center;
    margin-top: var(--space-m);
    font-size: var(--step--1);
    color: var(--color-text-inverse-muted);
  }
</style>

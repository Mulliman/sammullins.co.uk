---
/**
 * Intro (ticket 302): the original site's centred text section. A heading in the regular-weight
 * "sam-heading" style, a larger lead, and an optional button. Narrow (2/3 width) container.
 */
import Section from '../components/Section.astro';
import { md } from '../lib/markdown';
import type { BlockOf } from '../lib/content';

interface Props {
  block: BlockOf<'intro'>;
  nested?: boolean;
}
const { block, nested = false } = Astro.props;
const { heading, lead, cta, secondaryCta, align, variant, surface } = block;
---

<Section nested={nested} surface={surface} width="narrow">
  <div class:list={['intro', `intro--${align}`, `intro--${variant}`]}>
    {heading && <h2 class="intro__heading">{heading}</h2>}
    {lead && <div class="intro__lead" set:html={md(lead)} />}
    {(cta || secondaryCta) && (
      <p class="intro__cta">
        {cta && (
          <a class="button" href={cta.href}>
            {cta.label}
          </a>
        )}
        {secondaryCta && (
          <a class="button button--ghost" href={secondaryCta.href}>
            {secondaryCta.label}
          </a>
        )}
      </p>
    )}
  </div>
</Section>

<style>
  .intro--center {
    text-align: center;
  }
  /* 509-symmetry: a centred intro stays centred on phones. Its lead is a short subtitle (two lines at
     most on a desktop); longer text goes in a left-aligned prose block below it. */
  .intro--center .intro__lead {
    text-wrap: balance;
  }
  /* A heading on its own gets the same breathing room below it as a heading with a subtitle. */
  .intro:not(:has(.intro__lead, .intro__cta)) .intro__heading {
    margin-bottom: var(--space-m-l);
  }
  /* Phones: centred headings and subtitles sit in a narrower measure than the body, as the old site did. */
  @media (max-width: 39.99rem) {
    .intro--center .intro__heading,
    .intro--center .intro__lead {
      padding-inline: var(--space-s);
    }
  }
  .intro--left,
  .intro--left .intro__heading,
  .intro--left .intro__lead {
    text-align: left;
  }
  .intro__heading {
    margin: 0 0 var(--space-s);
    color: var(--color-text-strong);
  }
  .intro__lead {
    font-size: var(--step-1);
    line-height: var(--leading-lead);
    color: var(--color-text-muted);
  }
  /* Editorial variant: magazine-scale heading and display-face pull-quote deck. */
  .intro--editorial .intro__heading {
    font-size: var(--step-5);
    line-height: var(--leading-display);
    margin-bottom: var(--space-m);
  }
  .intro--editorial .intro__lead {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 420;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-heading);
    text-wrap: balance;
  }

  .intro--center .intro__lead {
    max-width: 36em;
    margin-inline: auto;
  }
  .intro__lead :global(p) {
    margin: 0;
  }
  .intro__lead :global(p + p) {
    margin-top: var(--space-s-m);
  }
  .intro__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: var(--space-m) 0 0;
  }
  .intro--center .intro__cta {
    justify-content: center;
  }
  /* No trailing margin: the section (or the gap to the next component) sets the spacing. */
  .intro > :last-child {
    margin-bottom: 0;
  }
  .intro > :first-child {
    margin-top: 0;
  }
</style>

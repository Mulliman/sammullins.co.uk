---
/**
 * Intro (ticket 302): the original site's centred text section. A heading in the regular-weight
 * "sam-heading" style, a larger lead, and an optional button. Narrow (2/3 width) container.
 */
import Section from '../components/Section.astro';
import { md } from '../lib/markdown';
import type { BlockOf } from '../lib/content';

interface Props {
  block: BlockOf<'intro'>;
  nested?: boolean;
}
const { block, nested = false } = Astro.props;
const { kicker, heading, lead, cta, align, surface } = block;
---

<Section nested={nested} surface={surface} width="narrow">
  <div class:list={['intro', `intro--${align}`]}>
    {kicker && <p class="intro__kicker">{kicker}</p>}
    {heading && <h2 class="intro__heading">{heading}</h2>}
    {lead && <div class="intro__lead" set:html={md(lead)} />}
    {cta && (
      <p class="intro__cta">
        <a class="button" href={cta.href}>
          {cta.label}
        </a>
      </p>
    )}
  </div>
</Section>

<style>
  .intro--center {
    text-align: center;
  }
  .intro--left,
  .intro--left .intro__heading,
  .intro--left .intro__lead {
    text-align: left;
  }
  .intro__kicker {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  /* The original's "sam-heading": regular weight and full black, unlike the thin headings elsewhere. */
  .intro__heading {
    margin: 0 0 20px;
    font-weight: 400;
    color: var(--color-text-strong);
  }
  .intro__lead {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--color-heading);
  }
  .intro__lead :global(p) {
    margin: 0;
  }
  .intro__lead :global(p + p) {
    margin-top: 20px;
  }
  .intro__cta {
    margin: var(--space-m) 0 0;
  }
  /* No trailing margin: the section (or the gap to the next component) sets the spacing. */
  .intro > :last-child {
    margin-bottom: 0;
  }
  .intro > :first-child {
    margin-top: 0;
  }
</style>

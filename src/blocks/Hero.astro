---
/**
 * Hero (ticket 301). Full-bleed, so it is not wrapped in Section.
 * variant: blurred (today's look) | image (framed photo, heading below) | plain (text only).
 * A variant without an image falls back to plain.
 */
import Pic from '../components/Pic.astro';
import { getSite, type BlockOf } from '../lib/content';

interface Props {
  block: BlockOf<'hero'>;
  nested?: boolean;
}
const { block } = Astro.props;
const { heading, subheading, image, align } = block;
const variant = image && block.variant !== 'plain' ? block.variant : 'plain';
// Ticket 905 prototype B: the blurred backdrop comes into focus as you scroll (flag in site.yaml).
const sharpen = (await getSite()).features.blurToSharpHero;
const framedAlt = image?.decorative ? '' : (image?.alt ?? '');
// A short subheading is a one-line subtitle ("Developer"); a sentence is a lead paragraph.
const subIsLead = (subheading?.length ?? 0) > 60;
---

<section class:list={['hero', `hero--${variant}`, `hero--${align}`, { 'hero--sharpen': sharpen }]}>
  {variant === 'blurred' && image && (
    <div class="hero__backdrop" aria-hidden="true">
      {/* Tiny unless it sharpens on scroll (905): decoding and blurring the full photo cost the home page
          its Lighthouse budget (804) on CI. */}
      <Pic src={image.src} alt="" preset={sharpen ? 'wide' : 'backdrop'} priority={sharpen} />
    </div>
  )}
  <div class="container hero__inner">
    {variant !== 'plain' && image && (
      <div class="hero__frame">
        <Pic src={image.src} alt={framedAlt} preset="wide" priority />
      </div>
    )}
    <div class="hero__text">
      <h1 class="hero__heading">{heading}</h1>
      {subheading && <p class:list={['hero__sub', { 'hero__sub--lead': subIsLead }]}>{subheading}</p>}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-l-xl);
    box-shadow: var(--shadow-inset);
  }

  /* Variant surfaces. Text colour is set on the section so the h1 inherits it. */
  .hero--blurred {
    background: var(--color-media-bg);
    color: var(--color-on-media);
  }
  .hero--image {
    background: var(--color-bg-muted);
    color: var(--color-text);
  }
  .hero--plain {
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }

  .hero__heading {
    color: inherit;
    margin: 0;
    font-size: var(--step-6);
  }
  .hero__sub {
    margin: var(--space-xs) 0 0;
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .hero__sub--lead {
    max-width: 38em;
    margin-top: var(--space-s);
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0;
    text-wrap: pretty;
  }
  .hero--center .hero__sub--lead {
    margin-inline: auto;
    text-wrap: balance;
  }
  .hero--blurred .hero__sub {
    color: var(--color-on-media-soft);
  }
  .hero--image .hero__heading {
    color: var(--color-text-strong);
  }
  .hero--image .hero__sub {
    color: var(--color-text-muted);
  }
  .hero--plain .hero__sub {
    color: var(--color-text-inverse-muted);
  }

  .hero__text {
    padding: var(--space-m-l);
  }
  .hero--blurred .hero__text,
  .hero--blurred .hero__heading {
    text-shadow: var(--text-shadow-media);
  }
  .hero--center .hero__text {
    text-align: center;
  }
  .hero--left .hero__text {
    text-align: left;
  }
  .hero--image .hero__text {
    margin-top: var(--space-m);
  }

  /* Blurred backdrop: the same image, heavily blurred and darkened, behind everything. */
  .hero__backdrop {
    position: absolute;
    inset: -5%;
    z-index: -1;
    pointer-events: none;
  }
  .hero__backdrop :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__backdrop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(5px) brightness(0.25);
    transform: scale(1.05);
  }

  /* Framed sharp image: thick white frame and shadow (site identity). */
  .hero__frame {
    margin: 0 auto;
    border: 10px solid var(--color-frame);
    box-shadow: var(--shadow);
    background: var(--color-frame);
  }
  .hero__frame :global(picture) {
    display: block;
  }
  .hero__frame :global(img) {
    width: 100%;
    height: auto;
  }

  /* Blurred: the text box is a dark translucent panel with a thin white border. */
  .hero--blurred .hero__text {
    background: var(--color-media-scrim);
    border: 2px solid var(--color-on-media);
  }
  .hero--blurred .hero__heading {
    color: var(--color-on-media);
  }

  /* Below 640px: no framed image; the text panel sits on the blurred background. */
  @media (max-width: 639.98px) {
    .hero--blurred .hero__frame {
      display: none;
    }
  }

  /* From 640px: the text panel is centred over the framed image. */
  @media (min-width: 640px) {
    .hero--blurred .hero__inner {
      position: relative;
    }
    .hero--blurred .hero__text {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: max-content;
      max-width: 90%;
      margin: 0;
    }
  }

  /* Subtle scroll-linked drift on the backdrop. CSS only, skipped without support or with reduced motion. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero--blurred .hero__backdrop {
        animation: hero-drift linear both;
        animation-timeline: scroll();
      }
    }
  }
  @keyframes hero-drift {
    from {
      transform: translate3d(0, -3%, 0);
    }
    to {
      transform: translate3d(0, 3%, 0);
    }
  }

  /* Prototype B (905): scroll-driven focus pull on the backdrop. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero--sharpen .hero__backdrop :global(img) {
        animation: hero-sharpen linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 80%;
      }
    }
  }
  @keyframes hero-sharpen {
    from {
      filter: blur(14px) brightness(0.35);
    }
    to {
      filter: blur(0) brightness(0.75);
    }
  }
</style>

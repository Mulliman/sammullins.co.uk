---
/**
 * Hero (tickets 301, 210). Full-bleed, so it is not wrapped in Section.
 * variant: plain (text on the dark band) | image (framed photo, heading below) | blurred (the photo over a
 * blurred copy of itself). A variant without an image falls back to plain.
 *
 * Ticket 210: optional calls to action (`ctas`, the first one solid) and, on a plain hero, `mark`: the
 * logo's bars drawn large and quiet beside the text, building in bar by bar like the header signature.
 * The text settles in on load with transform only (never opacity on the heading), so the LCP element
 * paints straight away.
 */
import Pic from '../components/Pic.astro';
import Logo from '../components/Logo.astro';
import { getSite, type BlockOf } from '../lib/content';

interface Props {
  block: BlockOf<'hero'>;
  nested?: boolean;
}
const { block } = Astro.props;
const { heading, subheading, image, align, ctas, mark } = block;
const variant = image && block.variant !== 'plain' ? block.variant : 'plain';
const marked = variant === 'plain' && mark;
// Ticket 905 prototype B: the blurred backdrop comes into focus as you scroll (flag in site.yaml).
const sharpen = (await getSite()).features.blurToSharpHero;
const framedAlt = image?.decorative ? '' : (image?.alt ?? '');
// A short subheading is a one-line subtitle ("Developer"); a sentence is a lead paragraph.
const subIsLead = (subheading?.length ?? 0) > 60;
// Ticket 509: `~~words~~` in the heading are shown struck through, so the home page can cross out
// "jack of all trades" and write a correction after it. Screen readers hear "crossed out" first.
const headingParts = heading.split(/~~(.+?)~~/).map((text, i) => ({ text, struck: i % 2 === 1 }));
---

<section
  class:list={[
    'hero',
    `hero--${variant}`,
    `hero--${marked ? 'left' : align}`,
    { 'hero--sharpen': sharpen, 'hero--marked': marked },
  ]}
>
  {variant === 'blurred' && image && (
    <div class="hero__backdrop" aria-hidden="true">
      {/* Tiny unless it sharpens on scroll (905): decoding and blurring the full photo cost the home page
          its Lighthouse budget (804) on CI. */}
      <Pic src={image.src} alt="" preset={sharpen ? 'wide' : 'backdrop'} priority={sharpen} />
    </div>
  )}
  <div class="container hero__inner">
    {variant !== 'plain' && image && (
      <div class="hero__frame">
        <Pic src={image.src} alt={framedAlt} preset="wide" priority />
      </div>
    )}
    <div class="hero__text">
      <h1 class="hero__heading">
        {headingParts.map((part) =>
          part.struck ? (
            <del class="hero__struck">
              <span class="visually-hidden">crossed out: </span>
              <span class="hero__struck-text">{part.text}</span>
            </del>
          ) : (
            part.text
          ),
        )}
      </h1>
      {subheading && <p class:list={['hero__sub', { 'hero__sub--lead': subIsLead }]}>{subheading}</p>}
      {ctas && ctas.length > 0 && (
        <p class="hero__ctas">
          {ctas.map((c, i) => (
            <a class:list={['button', { 'button--ghost': i > 0 }]} href={c.href}>
              {c.label}
            </a>
          ))}
        </p>
      )}
    </div>
    {marked && (
      <div class="hero__mark" aria-hidden="true">
        <Logo lockup="mark" />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    /* clip, not hidden: hidden makes the hero a scroll container, and scroll()/view() timelines then
       track the hero (which never scrolls) instead of the page (ticket 906). */
    overflow: clip;
    padding-block: var(--space-l-xl);
  }

  /* Variant surfaces. Text colour is set on the section so the h1 inherits it. */
  .hero--blurred {
    background: var(--color-media-bg);
    color: var(--color-on-media);
  }
  .hero--image {
    background: var(--color-bg-muted);
    color: var(--color-text);
  }
  .hero--plain {
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
    padding-block: var(--space-section);
  }

  .hero__heading {
    color: inherit;
    margin: 0;
    font-size: var(--step-6);
  }
  /* As in Sam's sketch: the crossed-out words sit smaller on their own line above the correction.
     Static default is already crossed out (no-JS and reduced motion). With JS and motion enabled,
     the strike line draws cleanly left-to-right on load, even if the phrase wraps on narrow screens. */
  .hero__struck {
    display: block;
    width: fit-content;
    margin-bottom: 0.3em;
    font-size: 0.44em;
    font-weight: 420;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    text-decoration: none;
    color: var(--color-text-inverse-muted);
    opacity: 0.68;
  }
  .hero--center .hero__struck {
    margin-inline: auto;
  }
  .hero--image .hero__struck {
    color: var(--color-text-muted);
  }
  .hero__struck-text {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 57%;
    background-size: 100% 0.09em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .hero__sub {
    margin: var(--space-s) 0 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: var(--leading-heading);
    letter-spacing: -0.01em;
  }
  .hero__sub--lead {
    max-width: 36em;
    margin-top: var(--space-m);
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: 400;
    line-height: var(--leading-lead);
    letter-spacing: 0;
    text-wrap: pretty;
  }
  .hero--center .hero__sub--lead {
    margin-inline: auto;
    text-wrap: balance;
  }
  /* Phones (ticket 210): a hero with a paragraph lead reads left-aligned; centred lines that long are
     hard to follow. */
  @media (max-width: 39.99rem) {
    .hero--center:has(.hero__sub--lead) .hero__text {
      text-align: left;
    }
    .hero--center .hero__sub--lead {
      text-wrap: pretty;
    }
    .hero--center:has(.hero__sub--lead) .hero__ctas {
      justify-content: flex-start;
    }
  }
  .hero--blurred .hero__sub {
    color: var(--color-on-media-soft);
  }
  .hero--image .hero__heading {
    color: var(--color-text-strong);
  }
  .hero--image .hero__sub {
    color: var(--color-text-muted);
  }
  .hero--plain .hero__sub {
    color: var(--color-text-inverse-muted);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: var(--space-m-l) 0 0;
  }
  .hero--center .hero__ctas {
    justify-content: center;
  }
  /* The ghost button on the dark band: a hairline that firms up on hover. */
  .hero--plain .hero__ctas :global(.button--ghost),
  .hero--blurred .hero__ctas :global(.button--ghost) {
    background: transparent;
    border-color: var(--color-inverse-border-strong);
    color: var(--color-text-inverse);
  }
  .hero--plain .hero__ctas :global(.button--ghost:hover),
  .hero--blurred .hero__ctas :global(.button--ghost:hover) {
    border-color: var(--color-text-inverse);
  }
  .hero--plain .hero__ctas :global(.button:not(.button--ghost)),
  .hero--blurred .hero__ctas :global(.button:not(.button--ghost)) {
    background: var(--color-button-inverse-bg);
    border-color: var(--color-button-inverse-bg);
    color: var(--color-button-inverse-fg);
  }

  .hero__text {
    padding: var(--space-m-l);
  }
  .hero--plain .hero__text {
    padding-inline: 0;
  }
  .hero--blurred .hero__text,
  .hero--blurred .hero__heading {
    text-shadow: var(--text-shadow-media);
  }
  .hero--center .hero__text {
    text-align: center;
  }
  .hero--left .hero__text {
    text-align: left;
  }
  .hero--image .hero__text {
    margin-top: var(--space-m);
  }

  /* The marked plain hero (the home page): a big display name, the lead, the actions, and the logo's
     bars on the right. */
  .hero--marked {
    padding-block: calc(var(--space-section) * 1.15) var(--space-section);
  }
  .hero--marked .hero__inner {
    display: grid;
    align-items: center;
    gap: var(--space-l);
  }
  .hero--marked .hero__heading {
    font-size: var(--step-7);
    font-weight: 700;
    line-height: var(--leading-hero);
    letter-spacing: -0.035em;
  }
  .hero--marked .hero__sub--lead {
    max-width: 36em;
    margin-top: var(--space-m-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-inverse-border);
    color: var(--color-text-inverse-muted);
  }
  .hero__mark {
    --logo-primary: var(--color-hero-mark);
    --logo-secondary: var(--color-hero-mark-soft);
    justify-self: end;
    width: min(100%, 30rem);
  }
  .hero__mark :global(svg) {
    width: 100%;
    height: auto;
  }
  @media (min-width: 48rem) {
    .hero--marked .hero__inner {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    }
  }
  @media (max-width: 39.99rem) {
    .hero__mark {
      display: none;
    }
  }
  @media (min-width: 40rem) and (max-width: 47.99rem) {
    /* Small tablets: tucked into the bottom corner, clear of the heading and lead. */
    .hero__mark {
      position: absolute;
      inset: auto calc(-1.5 * var(--gutter)) calc(-1 * var(--space-m)) auto;
      z-index: -1;
      width: 11rem;
      opacity: 0.45;
    }
  }

  /* Blurred backdrop: the same image, heavily blurred and darkened, behind everything. */
  .hero__backdrop {
    position: absolute;
    inset: -5%;
    z-index: -1;
    pointer-events: none;
  }
  .hero__backdrop :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__backdrop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(5px) brightness(0.25);
    transform: scale(1.05);
  }

  /* Framed image (ticket 210): the thick white 2021 frame is gone; a soft radius and shadow instead. */
  .hero__frame {
    margin: 0 auto;
    border-radius: var(--radius-m);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .hero__frame :global(picture) {
    display: block;
  }
  .hero__frame :global(img) {
    width: 100%;
    height: auto;
  }

  /* Blurred: the text sits on a dark translucent panel. */
  .hero--blurred .hero__text {
    background: var(--color-media-scrim);
    border-radius: var(--radius-m);
  }
  .hero--blurred .hero__heading {
    color: var(--color-on-media);
  }

  /* Below 640px: no framed image; the text panel sits on the blurred background. */
  @media (max-width: 639.98px) {
    .hero--blurred .hero__frame {
      display: none;
    }
  }

  /* From 640px: the text panel is centred over the framed image. */
  @media (min-width: 640px) {
    .hero--blurred .hero__inner {
      position: relative;
    }
    .hero--blurred .hero__text {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: max-content;
      max-width: 90%;
      margin: 0;
    }
  }

  /* Entrance (ticket 210). The heading moves but never fades, so it paints at once; the rest follows it
     in, then the bars of the mark build one after another. The cross-out strike draws across on load
     only when JS and motion are active; without JS or with reduced motion it sits already crossed out. */
  @media (prefers-reduced-motion: no-preference) {
    .hero--plain .hero__heading {
      animation: hero-rise var(--dur-reveal) var(--ease-out) backwards;
    }
    :global(html.js) .hero__struck {
      animation: hero-struck-fade 540ms var(--ease-out) 380ms backwards;
    }
    :global(html.js) .hero__struck-text {
      animation: hero-strike-draw 580ms var(--ease-out) 320ms backwards;
    }
    .hero--plain .hero__sub {
      animation: hero-fade-rise var(--dur-reveal) var(--ease-out) 120ms backwards;
    }
    .hero__ctas {
      animation: hero-fade-rise var(--dur-reveal) var(--ease-out) 220ms backwards;
    }
    .hero__mark :global(.logo-bar) {
      animation: hero-bar-in 1000ms var(--ease-out) backwards;
      animation-delay: calc(150ms + var(--i) * 75ms);
    }
  }
  @keyframes hero-strike-draw {
    from {
      background-size: 0% 0.09em;
    }
    to {
      background-size: 100% 0.09em;
    }
  }
  @keyframes hero-struck-fade {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.68;
    }
  }
  @keyframes hero-rise {
    from {
      translate: 0 0.35em;
    }
  }
  @keyframes hero-fade-rise {
    from {
      opacity: 0;
      translate: 0 var(--rise);
    }
  }
  @keyframes hero-bar-in {
    from {
      opacity: 0;
      transform: translate(-28%, 28%);
    }
  }

  /* Scroll-linked: the mark drifts up a little faster than the page, and the blurred backdrop drifts.
     Longhands only, never the `animation` shorthand: the build's CSS minifier (Lightning CSS) folds the
     shorthand and `animation-timeline` into one shorthand that Chrome rejects (ticket 906). */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero--blurred .hero__backdrop {
        animation-name: hero-drift;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll();
      }
      .hero--marked .hero__mark {
        animation-name: hero-mark-drift;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }
  @keyframes hero-drift {
    from {
      transform: translate3d(0, -3%, 0);
    }
    to {
      transform: translate3d(0, 3%, 0);
    }
  }
  @keyframes hero-mark-drift {
    to {
      translate: 0 -18%;
      opacity: 0.2;
    }
  }

  /* Prototype B (905): scroll-driven focus pull on the backdrop. Longhands only, as above (906). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero--sharpen .hero__backdrop :global(img) {
        animation-name: hero-sharpen;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 80%;
      }
    }
  }
  @keyframes hero-sharpen {
    from {
      filter: blur(14px) brightness(0.35);
    }
    to {
      filter: blur(0) brightness(0.75);
    }
  }
</style>

---
/**
 * `gallery` block (ticket 304): a masonry grid of links to full-size images.
 * Without JS each thumbnail simply opens the full image. The script in this file
 * enhances the grid into a native <dialog> lightbox (keyboard, swipe, focus return).
 */
import { getImage } from 'astro:assets';
import Section from '../components/Section.astro';
import Pic from '../components/Pic.astro';
import type { BlockOf } from '../lib/content';

interface Props { block: BlockOf<'gallery'>; nested?: boolean }
const { block, nested = false } = Astro.props;

const items = await Promise.all(
  block.images.map(async (img) => {
    const full = await getImage({
      src: img.src,
      width: Math.min(2000, img.src.width),
      format: 'webp',
    });
    return { img, href: full.src };
  }),
);
const viewerLabel = block.heading ? `${block.heading}: image viewer` : 'Image viewer';
---

<Section nested={nested}>
  <div class="gallery" data-gallery>
    {block.heading && <h2 class="gallery__heading">{block.heading}</h2>}

    <ul class="gallery__grid">
      {items.map(({ img, href }, i) => (
        <li class="gallery__item">
          <a class="gallery__link" href={href} data-caption={img.caption} data-index={i}>
            <Pic src={img.src} alt={img.decorative ? '' : img.alt} preset="card" />
          </a>
        </li>
      ))}
    </ul>

    <dialog class="lightbox" data-lightbox aria-label={viewerLabel}>
      <div class="lightbox__bar">
        <p class="lightbox__count" aria-live="polite"></p>
        <button type="button" class="lightbox__btn" data-close>Close</button>
      </div>
      <figure class="lightbox__figure">
        <img class="lightbox__img" alt="" decoding="async" />
        <figcaption class="lightbox__caption" hidden></figcaption>
      </figure>
      <div class="lightbox__nav">
        <button type="button" class="lightbox__btn" data-prev aria-label="Previous image">
          <span aria-hidden="true">&larr;</span> Previous
        </button>
        <button type="button" class="lightbox__btn" data-next aria-label="Next image">
          Next <span aria-hidden="true">&rarr;</span>
        </button>
      </div>
    </dialog>
  </div>
</Section>

<script>
  /** Enhances every `[data-gallery]` on the page. Progressive: links work without this. */
  const SWIPE_PX = 50;

  function enhance(root: HTMLElement) {
    if (root.dataset.ready) return;
    const dialog = root.querySelector<HTMLDialogElement>('dialog[data-lightbox]');
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('a.gallery__link'));
    if (!dialog || links.length === 0) return;

    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    const count = dialog.querySelector<HTMLElement>('.lightbox__count')!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-close]')!;
    const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-prev]')!;
    const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-next]')!;
    const n = links.length;
    const wrap = (i: number) => (i + n) % n;

    let current = 0;
    let opener: HTMLElement | null = null;
    let startX: number | null = null;
    let startType = '';

    const preload = (i: number) => {
      new Image().src = links[wrap(i)]!.href;
    };

    const show = (i: number) => {
      current = wrap(i);
      const link = links[current]!;
      img.src = link.href;
      img.alt = link.querySelector('img')?.alt ?? '';
      caption.textContent = link.dataset.caption ?? '';
      caption.hidden = !link.dataset.caption;
      count.textContent = `${current + 1} of ${n}`;
      // Only the neighbours: the image on screen is already loading.
      preload(current + 1);
      preload(current - 1);
    };

    const open = (i: number, trigger: HTMLElement) => {
      opener = trigger;
      show(i);
      if (!dialog.open) dialog.showModal();
    };

    // Our own close paths return focus at once. Escape goes through the native close
    // event, handled below.
    const closeDialog = () => {
      dialog.close();
      opener?.focus();
      opener = null;
    };

    links.forEach((link, i) => {
      link.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        open(i, link);
      });
    });

    prevBtn.hidden = nextBtn.hidden = n < 2;
    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));
    closeBtn.addEventListener('click', closeDialog);

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
    });

    // Click on the backdrop (the dialog element itself) closes.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeDialog();
    });

    dialog.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startType = e.pointerType;
    });
    dialog.addEventListener('pointerup', (e) => {
      if (startX === null || startType === 'mouse') { startX = null; return; }
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) < SWIPE_PX) return;
      show(dx < 0 ? current + 1 : current - 1);
    });
    dialog.addEventListener('pointercancel', () => { startX = null; });

    // Escape is native. Return focus to the thumbnail that opened the viewer.
    dialog.addEventListener('close', () => {
      opener?.focus();
      opener = null;
    });

    root.dataset.ready = '1';
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(enhance);
</script>

<style>
  .gallery__heading { margin-bottom: var(--space-m); }

  .gallery__grid {
    columns: 3 16rem;
    column-gap: var(--space-s);
    list-style: none;
    padding: 0;
  }
  .gallery__item {
    break-inside: avoid;
    margin-bottom: var(--space-s);
  }
  .gallery__link { display: block; }
  .gallery__link :global(img) {
    border: 6px solid var(--color-frame);
    box-shadow: var(--shadow-soft);
  }

  /* Lightbox */
  .lightbox {
    width: min(100vw - 2rem, 72rem);
    max-width: 100%;
    padding: var(--space-xs);
    border: 0;
    background: transparent;
    color: #f5f5f5;
  }
  .lightbox[open] {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.92); }

  .lightbox__bar,
  .lightbox__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xs);
  }
  .lightbox__count { font-size: var(--step--1); margin: 0; }
  .lightbox__figure { margin: 0; display: grid; gap: var(--space-2xs); justify-items: center; }
  .lightbox__img {
    display: block;
    max-width: 100%;
    max-height: 85vh;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lightbox__caption { font-size: var(--step--1); text-align: center; color: #c8c8c8; }

  .lightbox__btn {
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: var(--space-2xs) var(--space-s);
    background: rgb(255 255 255 / 0.1);
    color: #f5f5f5;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .lightbox__btn:hover { background: rgb(255 255 255 / 0.2); }
  .lightbox :focus-visible { outline-color: #8ab4ff; }
</style>

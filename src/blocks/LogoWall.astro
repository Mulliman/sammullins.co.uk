---
/**
 * `logoWall` block (ticket 306): client logos on white tiles, four to a row as the original.
 * Each logo's alt text is the client name. `variant: badges` (ticket 509) shows certificates and
 * awards in colour instead.
 *
 * Ticket 509: a logo with `details` is a button that opens a popover (the HTML popover API, so it needs
 * no script: Esc and clicking outside close it). It sits under the logo where CSS anchor positioning is
 * supported, and in the middle of the screen where it isn't.
 */
import Section from '../components/Section.astro';
import Pic from '../components/Pic.astro';
import { md } from '../lib/markdown';
import { nextId } from '../lib/ids';
import type { BlockOf } from '../lib/content';

interface Props {
  block: BlockOf<'logoWall'>;
  nested?: boolean;
}
const { block, nested = false } = Astro.props;
// Popover ids must be unique on the page, and a page can hold several walls.
const idBase = nextId('logo');
---

<Section nested={nested} surface={block.surface}>
  {block.heading && <h2 class="logos__heading">{block.heading}</h2>}
  <ul class:list={['logos', `logos--${block.variant}`]}>
    {block.logos.map((item, i) => {
      const pic = <Pic src={item.logo} alt={item.name} preset="logo" />;
      const popId = `${idBase}-${i}`;
      return (
        <li class="logos__item">
          {item.details ? (
            <>
              <button class="logos__link logos__button" type="button" popovertarget={popId} aria-haspopup="dialog">
                {pic}
              </button>
              <div class="logos__pop" id={popId} popover role="dialog" aria-label={item.name}>
                <p class="logos__pop-title">{item.name}</p>
                <div class="logos__pop-text" set:html={md(item.details)} />
                {item.href && (
                  <p class="logos__pop-visit">
                    <a class="arrow-link" href={item.href} target="_blank" rel="noopener">
                      Visit {item.name}
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  </p>
                )}
                <button class="logos__pop-close" type="button" popovertarget={popId} popovertargetaction="hide">
                  <span class="visually-hidden">Close</span>
                  <span aria-hidden="true">×</span>
                </button>
              </div>
            </>
          ) : item.href ? (
            <a class="logos__link" href={item.href} rel="noopener">
              {pic}
            </a>
          ) : (
            pic
          )}
        </li>
      );
    })}
  </ul>
</Section>

<style>
  .logos__heading {
    margin-bottom: var(--space-m);
  }

  /* Ticket 210: an open grid of logos with no borders (Sam, 26 November 2026). 3 across on a phone, 4
     from 640px, 6 from 960px, so twelve clients take two rows on a desktop instead of three screens.
     Logos rest at a quieter tone and come up on hover. */
  .logos {
    --cols: 3;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-s) var(--space-m);
    list-style: none;
    padding: 0;
  }
  @media (min-width: 640px) {
    .logos {
      --cols: 4;
    }
  }
  @media (min-width: 960px) {
    .logos {
      --cols: 6;
    }
  }

  .logos__item {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 8 / 5;
    padding: var(--space-2xs) var(--space-xs);
    background: var(--color-logo-tile);
  }
  .logos__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .logos__item :global(picture) {
    display: contents;
  }
  .logos__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.55;
    filter: grayscale(1);
    transition:
      opacity var(--dur) var(--ease),
      filter var(--dur) var(--ease),
      scale var(--dur) var(--ease-out);
  }
  /* Sam (27 November 2026): no borders and no background change (the logos' own white would show).
     Logos rest faded and come to full strength on hover, focus or while their popover is open. */
  .logos__item:hover :global(img),
  .logos__link:focus-visible :global(img),
  .logos__button[aria-expanded='true'] :global(img) {
    opacity: 1;
    filter: none;
  }
  .logos__button:hover :global(img) {
    scale: 1.04;
  }

  .logos__button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: var(--radius);
  }

  /* The popover: a small card under its logo. */
  .logos__pop {
    width: min(22rem, calc(100vw - 2 * var(--gutter)));
    margin: auto;
    padding: var(--space-s) var(--space-m) var(--space-s) var(--space-s);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-card);
    text-align: left;
  }
  .logos__pop::backdrop {
    background: transparent;
  }
  @supports (position-area: bottom) {
    .logos__pop {
      inset: auto;
      margin: var(--space-2xs) 0;
      position-area: bottom;
      position-try-fallbacks:
        bottom span-right,
        bottom span-left,
        flip-block;
    }
  }
  /* Phones: in the middle of the screen over a soft backdrop, clear of the edges (Sam: a sheet at
     the very bottom felt far from the logo). */
  @media (max-width: 39.99rem) {
    .logos__pop {
      inset: 0;
      width: auto;
      height: fit-content;
      margin: auto var(--gutter);
      position-area: none;
    }
    .logos__pop::backdrop {
      background: var(--color-backdrop);
    }
  }
  .logos__pop-title {
    margin: 0 0 var(--space-3xs);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-heading);
    line-height: var(--leading-heading);
    color: var(--color-text-strong);
  }
  .logos__pop-text {
    font-size: var(--step--1);
    line-height: var(--leading-small);
    color: var(--color-text-muted);
  }
  .logos__pop-text :global(p) {
    margin: 0;
  }
  .logos__pop-text :global(p + p) {
    margin-top: 0.6em;
  }
  .logos__pop-visit {
    margin: var(--space-xs) 0 0;
    font-size: var(--step--1);
  }
  .logos__pop-close {
    position: absolute;
    inset: var(--space-3xs) var(--space-3xs) auto auto;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--color-text-muted);
    font-size: var(--step-1);
    line-height: var(--leading-hero);
    cursor: pointer;
  }
  .logos__pop-close:hover {
    color: var(--color-text-strong);
  }
  @media (prefers-reduced-motion: no-preference) {
    .logos__pop {
      transition:
        opacity var(--dur) var(--ease-out),
        translate var(--dur) var(--ease-out),
        display var(--dur) allow-discrete,
        overlay var(--dur) allow-discrete;
    }
    .logos__pop:not(:popover-open) {
      opacity: 0;
      translate: 0 -0.25rem;
    }
    @starting-style {
      .logos__pop:popover-open {
        opacity: 0;
        translate: 0 -0.25rem;
      }
    }
  }
  @media (max-width: 639.98px) {
    .logos__item {
      padding: var(--space-3xs);
    }
  }

  /* Dark theme: light versions of the logos on the page colour. The masters are grey on white, so
     inverting gives light on black, and screen blending drops the black. */
  :global(:root[data-theme='dark']) .logos__item {
    background: var(--color-bg);
  }
  :global(:root[data-theme='dark']) .logos__item :global(img) {
    filter: invert(1) grayscale(1);
    mix-blend-mode: screen;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logos__item {
      background: var(--color-bg);
    }
    :global(:root:not([data-theme='light'])) .logos__item :global(img) {
      filter: invert(1) grayscale(1);
      mix-blend-mode: screen;
    }
  }

  /* Hairline-ruled specimen grid (editorial): 2x6 on phones, 3x4 on small tablets, 4x3 on wider layouts
     (zero orphans for 12 clients), monochrome at rest and responsive on hover. */
  .logos.logos--grid {
    --cols: 2;
    gap: 0;
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }
  @media (min-width: 36rem) {
    .logos.logos--grid {
      --cols: 3;
    }
  }
  @media (min-width: 56rem) {
    .logos.logos--grid {
      --cols: 4;
    }
  }
  .logos--grid .logos__item {
    padding: var(--space-s);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--dur) var(--ease);
  }
  .logos--grid .logos__item :global(img) {
    opacity: 0.78;
    transition:
      opacity var(--dur) var(--ease),
      filter var(--dur) var(--ease),
      transform var(--dur) var(--ease-out);
  }
  .logos--grid .logos__item:hover {
    background: var(--color-bg-muted);
  }
  .logos--grid .logos__item:hover :global(img) {
    opacity: 1;
    filter: none;
    transform: scale(1.04);
  }
  :global(:root[data-theme='dark']) .logos--grid .logos__item :global(img) {
    opacity: 0.85;
  }
  :global(:root[data-theme='dark']) .logos--grid .logos__item:hover {
    background: var(--color-bg-muted);
  }
  :global(:root[data-theme='dark']) .logos--grid .logos__item:hover :global(img) {
    opacity: 1;
    filter: invert(1) grayscale(1);
    mix-blend-mode: screen;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logos--grid .logos__item :global(img) {
      opacity: 0.85;
    }
    :global(:root:not([data-theme='light'])) .logos--grid .logos__item:hover {
      background: var(--color-bg-muted);
    }
    :global(:root:not([data-theme='light'])) .logos--grid .logos__item:hover :global(img) {
      opacity: 1;
      filter: invert(1) grayscale(1);
      mix-blend-mode: screen;
    }
  }

  /* Badges (ticket 509): certificates and awards in their own colours, side by side at a fixed size,
     with no tile and no grey. Declared after the dark rules so they win in both themes. */
  .logos.logos--badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-m);
  }
  @media (min-width: 48rem) {
    :global(.split__col:last-child) .logos.logos--badges {
      justify-content: flex-end;
    }
  }
  .logos--badges .logos__item,
  :global(:root[data-theme]) .logos--badges .logos__item {
    width: min(10rem, 42%);
    aspect-ratio: 1;
    padding: 0;
    background: none;
  }
  .logos--badges .logos__item:only-child,
  :global(:root[data-theme]) .logos--badges .logos__item:only-child {
    width: min(13rem, 65%);
  }
  /* Phones: badges small, so they don't take a screen of their own. */
  @media (max-width: 39.99rem) {
    .logos--badges .logos__item,
    .logos--badges .logos__item:only-child,
    :global(:root[data-theme]) .logos--badges .logos__item,
    :global(:root[data-theme]) .logos--badges .logos__item:only-child {
      width: 5rem;
    }
  }
  .logos--badges .logos__link {
    border-radius: var(--radius-m);
    transition: transform var(--dur) var(--ease-out);
  }
  .logos--badges .logos__link:hover {
    transform: translateY(-2px);
  }
  .logos--badges .logos__item :global(img),
  :global(:root[data-theme]) .logos--badges .logos__item :global(img) {
    opacity: 1;
    filter: none;
    mix-blend-mode: normal;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logos--badges .logos__item {
      background: none;
    }
    :global(:root:not([data-theme='light'])) .logos--badges .logos__item :global(img) {
      filter: none;
      mix-blend-mode: normal;
    }
  }
</style>

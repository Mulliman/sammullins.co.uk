---
/**
 * `logoWall` block (ticket 306): client logos on white tiles, four to a row as the original.
 * Each logo's alt text is the client name.
 */
import Section from '../components/Section.astro';
import Pic from '../components/Pic.astro';
import type { BlockOf } from '../lib/content';

interface Props {
  block: BlockOf<'logoWall'>;
  nested?: boolean;
}
const { block, nested = false } = Astro.props;
---

<Section nested={nested} surface={block.surface}>
  {block.heading && <h2 class="logos__heading">{block.heading}</h2>}
  <ul class="logos">
    {block.logos.map((item) => {
      const pic = <Pic src={item.logo} alt={item.name} preset="logo" />;
      return (
        <li class="logos__item">
          {item.href ? (
            <a class="logos__link" href={item.href} rel="noopener">
              {pic}
            </a>
          ) : (
            pic
          )}
        </li>
      );
    })}
  </ul>
</Section>

<style>
  .logos__heading {
    margin-bottom: var(--space-m);
  }

  /* As the original: 2 per row, 4 from 640px. Logos fill 80% of their tile. */
  .logos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 640px) {
    .logos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* White tiles keep the (white-backed) logos looking intentional in dark mode too. */
  .logos__item {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 3 / 2;
    padding: 10%;
    background: var(--color-logo-tile);
  }
  .logos__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .logos__item :global(picture) {
    display: contents;
  }
  .logos__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Dark theme: light versions of the logos. The masters are grey on white, so inverting gives
     light on black, and screen blending drops the black so they sit straight on the page. */
  :global(:root[data-theme='dark']) .logos__item {
    background: transparent;
  }
  :global(:root[data-theme='dark']) .logos__item :global(img) {
    filter: invert(1) grayscale(1);
    mix-blend-mode: screen;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logos__item {
      background: transparent;
    }
    :global(:root:not([data-theme='light'])) .logos__item :global(img) {
      filter: invert(1) grayscale(1);
      mix-blend-mode: screen;
    }
  }
</style>

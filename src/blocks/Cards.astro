---
/**
 * `cards` block (ticket 305): manual items, a query, or both (manual first).
 * Renders nothing when there are no cards.
 */
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import { runQuery, urlFor, type BlockOf } from '../lib/content';

interface Props {
  block: BlockOf<'cards'>;
  nested?: boolean;
}
const { block, nested = false } = Astro.props;

type CardImage = NonNullable<NonNullable<BlockOf<'cards'>['items']>[number]['image']>;
interface CardData {
  title: string;
  text?: string | undefined;
  image?: CardImage | undefined;
  href?: string | undefined;
  date?: Date | undefined;
  cta?: string | undefined;
}

const items: CardData[] = [
  ...(block.items ?? []),
  ...(block.query
    ? (await runQuery(block.query)).map((e) => ({
        title: e.data.title,
        text: e.data.description,
        image: e.data.cover,
        href: urlFor(e),
        date: e.data.date,
      }))
    : []),
];
---

{items.length > 0 && (
  <Section surface={block.surface} nested={nested}>
    {block.heading && <h2 class="cards__heading">{block.heading}</h2>}
    <ul class:list={['cards__grid', `cards--cols-${block.columns}`]}>
      {items.map((item) => (
        <li class="cards__item">
          <Card
            title={item.title}
            text={item.text}
            image={item.image}
            href={item.href}
            date={item.date}
            cta={item.cta}
            variant={block.variant}
          />
        </li>
      ))}
    </ul>
  </Section>
)}

<style>
  .cards__heading {
    text-align: center;
    margin-bottom: var(--space-l);
  }
  /* As the original UIkit grid: 1 column, 2 from 640px, N from 960px. Rows are centred,
     so a lone card sits in the middle at its column width. */
  .cards__grid {
    --cols: 1;
    --gap: 15px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cards__item {
    display: flex;
    min-width: 0;
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
  }
  @media (min-width: 640px) {
    .cards__grid:not(.cards--cols-1) {
      --cols: 2;
    }
  }
  @media (min-width: 960px) {
    .cards__grid.cards--cols-3 {
      --cols: 3;
    }
    .cards__grid.cards--cols-4 {
      --cols: 4;
    }
  }
</style>

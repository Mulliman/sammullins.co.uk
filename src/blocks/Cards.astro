---
/**
 * `cards` block (ticket 305): manual items, a query, or both (manual first).
 * Renders nothing when there are no cards.
 */
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import { runQuery, urlFor, type BlockOf } from '../lib/content';

interface Props { block: BlockOf<'cards'>; nested?: boolean }
const { block, nested = false } = Astro.props;

type CardImage = NonNullable<NonNullable<BlockOf<'cards'>['items']>[number]['image']>;
interface CardData {
  title: string;
  text?: string | undefined;
  image?: CardImage | undefined;
  href?: string | undefined;
  date?: Date | undefined;
}

const items: CardData[] = [
  ...(block.items ?? []),
  ...(block.query
    ? (await runQuery(block.query)).map((e) => ({
        title: e.data.title,
        text: e.data.description,
        image: e.data.cover,
        href: urlFor(e),
        date: e.data.date,
      }))
    : []),
];
---

{items.length > 0 && (
  <Section surface={block.surface} nested={nested}>
    {block.heading && <h2 class="cards__heading">{block.heading}</h2>}
    <ul class:list={['cards__grid', `cards--cols-${block.columns}`]}>
      {items.map((item) => (
        <li class="cards__item">
          <Card
            title={item.title}
            text={item.text}
            image={item.image}
            href={item.href}
            date={item.date}
            variant={block.variant}
          />
        </li>
      ))}
    </ul>
  </Section>
)}

<style>
  .cards__heading {
    text-align: center;
    margin-bottom: var(--space-l);
  }
  /* Columns are a ceiling: each track is at least its share of the container width, so the
     grid holds at most N columns and collapses to fewer (then one) as the width shrinks. */
  .cards__grid {
    --cols: 3;
    --gap: var(--space-m);
    --min: calc((var(--container) - (var(--cols) - 1) * var(--gap)) / var(--cols));
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--min)), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cards--cols-1 { --cols: 1; }
  .cards--cols-2 { --cols: 2; }
  .cards--cols-3 { --cols: 3; }
  .cards--cols-4 { --cols: 4; }
  .cards__item {
    display: flex;
    min-width: 0;
  }
</style>

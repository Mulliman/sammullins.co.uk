---
/**
 * `cards` block (ticket 305): manual items, a query, or both (manual first).
 * Renders nothing when there are no cards.
 */
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import { runQuery, urlFor, type BlockOf } from '../lib/content';

interface Props {
  block: BlockOf<'cards'>;
  nested?: boolean;
}
const { block, nested = false } = Astro.props;

type CardImage = NonNullable<NonNullable<BlockOf<'cards'>['items']>[number]['image']>;
interface CardData {
  title: string;
  text?: string | undefined;
  image?: CardImage | undefined;
  href?: string | undefined;
  date?: Date | undefined;
  cta?: string | undefined;
  award?: { label: string; title: string; detail?: string | undefined } | undefined;
}

const items: CardData[] = [
  ...(block.items ?? []),
  ...(block.query
    ? (await runQuery(block.query)).map((e) => ({
        title: e.data.title,
        text: e.data.description,
        image: e.data.cover,
        href: urlFor(e),
        date: e.data.date,
      }))
    : []),
];
---

{items.length > 0 && (
  <Section surface={block.surface} nested={nested}>
    {block.heading && <h2 class="cards__heading">{block.heading}</h2>}
    <ul class:list={['cards__grid', `cards--cols-${block.columns}`, `cards--variant-${block.variant}`]}>
      {items.map((item) => (
        <li class="cards__item">
          <Card
            headingLevel={block.heading || nested ? 3 : 2}
            title={item.title}
            text={item.text}
            image={item.image}
            href={item.href}
            date={item.date}
            cta={item.cta}
            award={item.award}
            variant={block.variant}
          />
        </li>
      ))}
    </ul>
  </Section>
)}

<style>
  .cards__heading {
    text-align: center;
    margin-bottom: var(--space-m-l);
  }
  /* Ticket 210: a real grid with a wider row gap than column gap. 1 column, 2 from 640px, N from 960px. */
  .cards__grid {
    --cols: 1;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-m) var(--space-s-m);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cards__item {
    display: flex;
    min-width: 0;
  }
  @media (max-width: 639.98px) {
    .cards__grid {
      row-gap: var(--space-s);
    }
  }
  @media (min-width: 640px) {
    .cards__grid:not(.cards--cols-1) {
      --cols: 2;
    }
    /* Row cards (thumbnail beside text) need the width: one per line until 960px. */
    .cards__grid.cards--variant-row {
      --cols: 1;
    }
    /* Two-up image cards stop at the narrow column, or they become posters; text and row cards use
       the full container, so a page's edges don't jump between bands. */
    .cards__grid.cards--cols-2:has(.card__media):not(.cards--variant-row) {
      max-width: var(--container-narrow);
      margin-inline: auto;
    }
    /* One card on its own is a feature (see Card): it spans the row. It keeps the narrow column, unless
       its section also holds a wider grid, where it lines up with that grid instead. */
    .cards__grid:has(> .cards__item:only-child) {
      --cols: 1;
      max-width: var(--container-narrow);
      margin-inline: auto;
    }
    :global(.section:has(.cards--cols-3, .cards--cols-4, .cards--variant-row))
      .cards__grid:has(> .cards__item:only-child) {
      max-width: none;
    }
  }
  @media (min-width: 960px) {
    .cards__grid.cards--variant-row.cards--cols-2 {
      --cols: 2;
    }
    .cards__grid.cards--cols-3 {
      --cols: 3;
    }
    .cards__grid.cards--cols-4 {
      --cols: 4;
    }
  }
</style>

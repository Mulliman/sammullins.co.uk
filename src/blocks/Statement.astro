---
/**
 * `statement` block: magazine-scale editorial statements.
 * `variant: manifesto` frames high-impact display sentences between hairline rules.
 * `variant: acrostic` sets lines whose first letters spell a word (the closing S, A, M lines on the
 * home page). Only the first letter is bold; readers are trusted to notice (Sam, 27 November 2026).
 * `~~words~~` are struck through, the line drawing across as it scrolls into view (ticket 509).
 */
import Section from '../components/Section.astro';
import { mdInline } from '../lib/markdown';
import type { BlockOf } from '../lib/content';

interface Props {
  block: BlockOf<'statement'>;
  nested?: boolean;
}
const { block, nested = false } = Astro.props;
// Screen readers hear "crossed out" before struck words, as in the hero.
const render = (line: string) =>
  mdInline(line).replace(/<del>/g, '<del><span class="visually-hidden">crossed out: </span>');
// The first letter of an acrostic line, split off so it can be bold.
const initialOf = (line: string) => {
  const html = render(line);
  const m = html.match(/^([A-Za-z])/);
  return m ? { initial: m[1]!, rest: html.slice(1) } : { initial: '', rest: html };
};
---

<Section nested={nested} surface={block.surface} width="narrow">
  {block.heading && <h2 class="statement__heading">{block.heading}</h2>}
  <div class:list={['statement__wrap', `statement__wrap--${block.align}`]}>
    {block.variant === 'acrostic' ? (
      <ul class="statement statement--acrostic">
        {block.lines.map((line) => {
          const { initial, rest: html } = initialOf(line);
          return (
            <li class="statement__row">
              <p class="statement__line">
                <b class="statement__initial">{initial}</b>
                <Fragment set:html={html} />
              </p>
            </li>
          );
        })}
      </ul>
    ) : (
      <div class="statement statement--manifesto">
        {block.lines.map(render).map((html) => (
          <p class="statement__line" set:html={html} />
        ))}
      </div>
    )}
  </div>
</Section>

<style>
  .statement__wrap--center {
    text-align: center;
  }
  .statement__heading {
    margin: 0 0 var(--space-m-l);
    color: var(--color-text-strong);
  }

  /* Acrostic: one sentence per hairline-ruled row, the first letter bold. */
  .statement--acrostic {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }
  .statement__row {
    padding-block: var(--space-s-m);
    border-bottom: 1px solid var(--color-border);
    transition: border-color var(--dur) var(--ease);
  }
  .statement__row:hover {
    border-bottom-color: var(--color-border-strong);
  }
  .statement--acrostic .statement__line {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 380;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-heading);
    text-wrap: balance;
    transition: translate var(--dur) var(--ease-out);
  }
  .statement__initial {
    font-weight: 800;
    color: var(--color-text-strong);
  }
  .statement__wrap--left .statement__row:hover .statement__line {
    translate: 0.2em 0;
  }

  /* Manifesto: display statements between hairlines. */
  .statement--manifesto {
    padding-block: var(--space-l);
    border-top: 2px solid var(--color-text-strong);
    display: grid;
    gap: var(--space-2xs);
  }
  .statement--manifesto .statement__line {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 600;
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-strong);
    text-wrap: balance;
  }
  /* The last line lands the point; the lines before it lead up to it, quieter. */
  .statement--manifesto .statement__line:not(:last-child) {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  /* Struck words: a drawn line rather than text-decoration, so it can animate. Static default is
     already crossed out (no support, reduced motion, screenshots). */
  .statement :global(del) {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 55%;
    background-size: 100% 0.08em;
    color: var(--color-text-muted);
  }

  /* Scroll-driven: the acrostic lines settle in, and the strike draws across as its line arrives. Never
     opacity: 0, so full-page screenshots stay complete. Longhands only (ticket 906). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .statement--acrostic .statement__line {
        animation-name: statement-line-in;
        animation-timing-function: var(--ease-out);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% cover 35%;
      }
      .statement :global(del) {
        animation-name: statement-strike;
        animation-timing-function: var(--ease-out);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 100% cover 45%;
      }
    }
  }
  @keyframes statement-line-in {
    from {
      translate: 0.5rem 0;
    }
    to {
      translate: 0 0;
    }
  }
  @keyframes statement-strike {
    from {
      background-size: 0% 0.08em;
    }
    to {
      background-size: 100% 0.08em;
    }
  }
</style>

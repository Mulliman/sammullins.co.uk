---
/** `split` block (ticket 308): two columns of nested blocks. */
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Section from '../components/Section.astro';
import Blocks from '../components/Blocks.astro';
import type { Block } from '../lib/content';
type SplitBlock = Extract<Block, { type: 'split' }>;
interface Props {
  block: SplitBlock;
  Content?: AstroComponentFactory | undefined;
  /** Inside a section (ticket 509): no band of its own. */
  nested?: boolean;
}
const { block, Content, nested = false } = Astro.props;
const [a, b] = block.columns;
---

<Section nested={nested}>
  <div
    class:list={[
      'split',
      `split--${block.ratio.replace(':', '-')}`,
      { 'split--reverse': block.reverseOnMobile, 'split--sticky': block.sticky },
    ]}
  >
    <div class="split__col">
      <Blocks blocks={a} Content={Content} nested />
    </div>
    <div class="split__col">
      <Blocks blocks={b} Content={Content} nested />
    </div>
  </div>
</Section>
<style>
  .split {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }
  /* In a section, text beside a badge sits level with it unless sticky top-alignment is requested. */
  :global(.nested-block) > .split:not(.split--sticky) {
    align-items: center;
  }
  .split__col {
    min-width: 0;
  }
  @media (min-width: 48rem) {
    .split--1-1 {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .split--1-2 {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }
    .split--2-1 {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
    .split--sticky > .split__col:first-child {
      position: sticky;
      top: calc(var(--header-h) + var(--space-l));
    }
  }
  @media (max-width: 47.99rem) {
    .split--reverse .split__col:first-child {
      order: 2;
    }
  }
</style>

---
/**
 * `indexList` block: an editorial ruled list.
 * `variant: numbered` pairs each row with a tabular 01/02/03 index rail;
 * `variant: ruled` lays out titled rows across a hairline two-column editorial grid.
 */
import Section from '../components/Section.astro';
import { md } from '../lib/markdown';
import type { BlockOf } from '../lib/content';

interface Props {
  block: BlockOf<'indexList'>;
  nested?: boolean;
}
const { block, nested = false } = Astro.props;
const ListTag = block.variant === 'numbered' ? 'ol' : 'ul';
const Heading = block.heading || nested ? 'h3' : 'h2';
---

<Section nested={nested} surface={block.surface}>
  {block.heading && <h2 class="index-list__heading">{block.heading}</h2>}
  <ListTag class:list={['index-list', `index-list--${block.variant}`]}>
    {block.items.map((item, i) => (
      <li class:list={['index-list__item', { 'index-list__item--titled': Boolean(item.title) }]}>
        {block.variant === 'numbered' && (
          <span class="index-list__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
        )}
        <div class="index-list__body">
          {item.title && <Heading class="index-list__title">{item.title}</Heading>}
          <div class="index-list__text" set:html={md(item.text)} />
        </div>
      </li>
    ))}
  </ListTag>
</Section>

<style>
  .index-list__heading {
    margin: 0 0 var(--space-m-l);
    color: var(--color-text-strong);
  }

  .index-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .index-list__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xs) var(--space-m);
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--color-border);
    transition: border-color var(--dur) var(--ease);
  }
  .index-list__item:hover {
    border-bottom-color: var(--color-border-strong);
  }

  /* Numbered variant: quiet tabular index rail on the left. */
  .index-list--numbered .index-list__item {
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: baseline;
  }
  @media (min-width: 40rem) {
    .index-list--numbered .index-list__item {
      grid-template-columns: 3.25rem minmax(0, 1fr);
    }
  }
  .index-list__num {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 350;
    line-height: var(--leading-heading);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    transition:
      color var(--dur) var(--ease),
      translate var(--dur) var(--ease);
  }
  .index-list__item:hover .index-list__num {
    color: var(--color-text-strong);
    translate: 0.15em 0;
  }

  .index-list__body {
    min-width: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  /* Ruled variant with titles: architectural two-column split per row on wider screens. */
  @media (min-width: 40rem) {
    .index-list--ruled .index-list__item--titled .index-list__body {
      grid-template-columns: minmax(9rem, 12rem) minmax(0, 1fr);
      align-items: baseline;
      gap: var(--space-xs) var(--space-l);
    }
  }

  .index-list__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: var(--weight-heading);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text-strong);
    transition: translate var(--dur) var(--ease);
  }
  .index-list__item:hover .index-list__title {
    translate: 0.15em 0;
  }

  .index-list__text {
    font-size: var(--step-0);
    line-height: var(--leading-body);
    color: var(--color-text);
  }
  .index-list__item--titled .index-list__text {
    color: var(--color-text-muted);
  }
  .index-list__text :global(p) {
    margin: 0;
  }
  .index-list__text :global(p + p) {
    margin-top: var(--space-xs);
  }
</style>

---
/**
 * `indexList` block: an editorial ruled list.
 * `variant: numbered` pairs each row with a tabular 01/02/03 index rail;
 * `variant: ruled` lays out titled rows across a hairline two-column editorial grid.
 * An item's `icon` (ticket 509) sits in the rail instead of a number.
 * `variant: columns` (ticket 509) sets the items side by side, centred, with the icon on top.
 */
import Icon from '../components/Icon.astro';
import Section from '../components/Section.astro';
import { md } from '../lib/markdown';
import type { BlockOf } from '../lib/content';

interface Props {
  block: BlockOf<'indexList'>;
  nested?: boolean;
}
const { block, nested = false } = Astro.props;
const ListTag = block.variant === 'numbered' ? 'ol' : 'ul';
const Heading = block.heading || nested ? 'h3' : 'h2';
---

<Section nested={nested} surface={block.surface}>
  {block.heading && <h2 class="index-list__heading">{block.heading}</h2>}
  <ListTag class:list={['index-list', `index-list--${block.variant}`]}>
    {block.items.map((item, i) => (
      <li
        class:list={[
          'index-list__item',
          {
            'index-list__item--titled': Boolean(item.title),
            'index-list__item--icon': Boolean(item.icon || item.marker),
          },
        ]}
      >
        {item.icon && (
          <span class="index-list__icon">
            <Icon name={item.icon} />
          </span>
        )}
        {!item.icon && item.marker && <span class="index-list__icon index-list__marker">{item.marker}</span>}
        {block.variant === 'numbered' && !item.icon && (
          <span class="index-list__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
        )}
        <div class="index-list__body">
          {item.title && <Heading class="index-list__title">{item.title}</Heading>}
          <div class="index-list__text" set:html={md(item.text)} />
        </div>
      </li>
    ))}
  </ListTag>
</Section>

<style>
  .index-list__heading {
    margin: 0 0 var(--space-m-l);
    color: var(--color-text-strong);
  }

  /* 509-symmetry: no rules. Rows are separated by space, and a hovered row takes a tonal band. */
  .index-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .index-list--numbered,
  .index-list--ruled {
    display: grid;
    gap: var(--space-xs);
  }

  .index-list__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xs) var(--space-m);
    padding-block: var(--space-m);
    padding-inline: var(--space-s);
    /* The band bleeds into the margin, so the text stays on the heading's left edge. */
    margin-inline: calc(-1 * var(--space-s));
    border-radius: var(--radius-m);
    transition: background-color var(--dur) var(--ease);
  }
  .index-list__item:hover {
    background-color: var(--color-bg-muted);
  }
  :global(.surface-muted) .index-list__item:hover {
    background-color: var(--color-surface);
  }

  /* Numbered variant: quiet tabular index rail on the left. */
  .index-list--numbered .index-list__item {
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: baseline;
  }
  @media (min-width: 40rem) {
    .index-list--numbered .index-list__item {
      grid-template-columns: 3.25rem minmax(0, 1fr);
    }
  }
  .index-list__num {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 350;
    line-height: var(--leading-heading);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    transition:
      color var(--dur) var(--ease),
      translate var(--dur) var(--ease);
  }
  .index-list__item:hover .index-list__num {
    color: var(--color-text-strong);
    translate: 0.15em 0;
  }

  /* Icon rail (ticket 509): a line icon in a soft disc, which fills on hover. */
  .index-list__item--icon {
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-2xs) var(--space-s-m);
  }
  .index-list--ruled .index-list__item--icon:not(.index-list__item--titled) {
    align-items: center;
  }
  .index-list__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-bg-muted);
    color: var(--color-text-strong);
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  :global(.surface-muted) .index-list__icon {
    background: var(--color-surface);
  }
  .index-list__icon :global(.icon) {
    width: 1.3rem;
    height: 1.3rem;
  }
  .index-list__item:hover .index-list__icon {
    background: var(--color-text-strong);
    color: var(--color-bg);
  }
  @media (min-width: 40rem) {
    .index-list__item--icon {
      grid-template-columns: 3.25rem minmax(0, 1fr);
    }
    .index-list__icon {
      width: 3.25rem;
    }
  }

  /* Columns (ticket 509): up to three across, centred, icon above title above text, no rules. */
  /* Three to a row; a shorter last row is centred under the others (five items sit three over two). */
  .index-list--columns {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
  @media (min-width: 48rem) {
    .index-list--columns {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-l) var(--space-l-xl);
    }
    .index-list--columns > .index-list__item {
      flex: 0 1 calc((100% - 2 * var(--space-l-xl)) / 3);
    }
    .index-list--columns:has(> :nth-child(4):last-child) > .index-list__item {
      flex-basis: calc((100% - var(--space-l-xl)) / 2);
    }
  }
  @media (min-width: 64rem) {
    .index-list--columns:has(> :nth-child(4):last-child) > .index-list__item {
      flex-basis: calc((100% - 3 * var(--space-l)) / 4);
    }
    .index-list--columns:has(> :nth-child(4):last-child) {
      column-gap: var(--space-l);
    }
  }
  .index-list--columns .index-list__item,
  .index-list--columns .index-list__item:hover {
    align-content: start;
    padding: 0;
    margin-inline: 0;
    border-radius: 0;
    background: none;
  }
  /* Phones: rows with the icon beside the text, left-aligned like the heading above them. */
  @media (max-width: 47.99rem) {
    .index-list--columns .index-list__item {
      grid-template-columns: 3.25rem minmax(0, 1fr);
      gap: var(--space-s);
    }
    .index-list--columns .index-list__icon {
      width: 2.75rem;
    }
    .index-list--columns .index-list__icon :global(.icon) {
      width: 1.25rem;
      height: 1.25rem;
    }
  }
  @media (min-width: 48rem) {
    .index-list--columns .index-list__item {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: var(--space-s);
      text-align: center;
    }
    .index-list--columns .index-list__icon {
      width: 3.75rem;
    }
    .index-list--columns .index-list__body {
      justify-items: center;
    }
  }
  @media (min-width: 48rem) {
    .index-list--columns .index-list__icon :global(.icon) {
      width: 1.6rem;
      height: 1.6rem;
    }
  }
  .index-list--columns .index-list__item:hover .index-list__title {
    translate: none;
  }
  .index-list--columns .index-list__text {
    max-width: 22rem;
  }

  /* A text marker (509-symmetry): a pill, so a range like "25-now" fits. */
  .index-list__marker {
    width: auto;
    min-width: 2.75rem;
    aspect-ratio: auto;
    min-height: 2.75rem;
    padding-inline: 0.6em;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .index-list__item--icon:has(.index-list__marker) {
    grid-template-columns: auto minmax(0, 1fr);
  }
  @media (min-width: 40rem) {
    .index-list__item--icon:has(.index-list__marker) {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }
    .index-list__marker {
      justify-self: start;
      min-height: 3.25rem;
    }
  }

  .index-list__body {
    min-width: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  /* Ruled variant with titles: architectural two-column split per row on wider screens. */
  @media (min-width: 40rem) {
    .index-list--ruled .index-list__item--titled .index-list__body {
      grid-template-columns: minmax(9rem, 12rem) minmax(0, 1fr);
      align-items: baseline;
      gap: var(--space-xs) var(--space-l);
    }
  }

  .index-list__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: var(--weight-heading);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text-strong);
    transition: translate var(--dur) var(--ease);
  }
  .index-list__item:hover .index-list__title {
    translate: 0.15em 0;
  }

  .index-list__text {
    font-size: var(--step-0);
    line-height: var(--leading-body);
    color: var(--color-text);
  }
  .index-list__item--titled .index-list__text {
    color: var(--color-text-muted);
  }
  .index-list__text :global(p) {
    margin: 0;
  }
  .index-list__text :global(p + p) {
    margin-top: var(--space-xs);
  }
</style>

---
/** Quote (ticket 307): a pull quote in <figure><blockquote cite>, attribution in <figcaption>. */
import Section from '../components/Section.astro';
import { md } from '../lib/markdown';
import type { BlockOf } from '../lib/content';

interface Props {
  block: BlockOf<'quote'>;
  nested?: boolean;
}
const { block, nested = false } = Astro.props;
const { text, attribution, source, variant } = block;
const caption = attribution ?? source;
---

<Section nested={nested} width="narrow">
  <figure class:list={['quote', `quote--${variant}`]}>
    <blockquote cite={source}>
      <div class="quote__text" set:html={md(text)} />
    </blockquote>
    {caption && <figcaption class="quote__caption">{source ? <a href={source}>{caption}</a> : caption}</figcaption>}
  </figure>
</Section>

<style>
  .quote {
    margin: 0;
  }
  .quote blockquote {
    margin: 0;
  }

  /* A hanging opening mark in the accent colour, outside the text's left edge where there is room. */
  .quote__text {
    position: relative;
    font-size: var(--step-2);
    font-weight: 500;
    line-height: var(--leading-heading);
    letter-spacing: -0.01em;
    color: var(--color-heading);
  }
  .quote__text::before {
    content: '\201C';
    position: absolute;
    inset-inline-end: calc(100% + 0.1em);
    top: 0;
    color: var(--color-border-strong);
  }
  @media (max-width: 899px) {
    .quote__text::before {
      position: static;
    }
  }
  .quote__text :global(p) {
    margin: 0;
  }
  .quote__text :global(p + p) {
    margin-top: 0.75em;
  }

  .quote__caption {
    margin-top: var(--space-s);
    padding-left: var(--space-s);
    border-left: 1px solid var(--color-border-strong);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }
  .quote__caption :global(p) {
    margin: 0;
  }

  /* Display (ticket 509): a large, centred line between two big quote marks, caption underneath. */
  .quote--display {
    text-align: center;
  }
  .quote--display .quote__text {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 600;
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-strong);
    text-wrap: balance;
  }
  .quote--display .quote__text::before,
  .quote--display .quote__text::after {
    position: static;
    color: var(--color-border-strong);
    font-weight: 400;
  }
  .quote--display .quote__text::before {
    content: '\201C';
  }
  .quote--display .quote__text::after {
    content: '\201D';
  }
  .quote--display .quote__text :global(p) {
    display: inline;
  }
  .quote--display .quote__caption {
    display: inline-block;
    margin-top: var(--space-s);
    padding-left: 0;
    border-left: 0;
  }
</style>

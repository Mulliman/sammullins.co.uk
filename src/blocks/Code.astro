---
/**
 * Code (ticket 307): a code block with an optional filename tab and a Copy button.
 * Rendered as escaped text (no build-time highlighting: see report). The block scrolls
 * horizontally inside itself and is focusable so keyboard users can scroll it.
 * The markup is the shared code figure (src/lib/markdown.ts, ticket 1005), so fenced code in block
 * Markdown and `steps` look and copy the same. Styles: global.css. Copy script: CopyCode.astro.
 */
import Section from '../components/Section.astro';
import { codeFigure } from '../lib/markdown';
import type { BlockOf } from '../lib/content';

interface Props {
  block: BlockOf<'code'>;
  nested?: boolean;
}
const { block, nested = false } = Astro.props;
---

<Section nested={nested} width="narrow">
  <Fragment set:html={codeFigure(block)} />
</Section>

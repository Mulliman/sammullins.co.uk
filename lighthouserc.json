{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/articles/5-cool-things-i-used-to-build-xstatic/",
        "http://localhost/software/xstatic-for-umbraco/deploying-using-git/",
        "http://localhost/photography/photoshare21/around-the-disney-world/",
        "http://localhost/404.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 51200 }],
            "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 51200 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*404[.]html).*$",
          "assertions": {
            "categories:seo": ["error", { "minScore": 1 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": "./.lighthouseci" }
  }
}
